<!DOCTYPE html>
<html lang="en">
<head>

	<title>PetJoy - eCommerce Pet Shop Website</title>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="format-detection" content="telephone=no">
	<meta name="apple-mobile-web-app-capable" content="yes">
	<meta name="author" content="">
	<meta name="keywords" content="">
	<meta name="description" content="">

	<script src="https://cdn.tailwindcss.com"></script>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet"
		  integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ" crossorigin="anonymous">
	<link rel="stylesheet" type="text/css" href="~/css/vendor.css">
	<link rel="stylesheet" type="text/css" href="~/css/style.css">

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Chilanka&family=Montserrat:wght@300;400;500;600;700&display=swap"
		  rel="stylesheet">

	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

	<style>
		html {
			height: 100%;
		}

		body {
			min-height: 100vh;
			display: flex;
			flex-direction: column;
			margin: 0;
			padding-bottom: 50px;
		}

		h1, h2, h3, h4, h5, h6, input, button, select, textarea, a {
			font-family: 'Montserrat', sans-serif !important;
		}

		#content-wrap {
			flex: 1;
		}

		#secondary-nav a,
		#secondary-nav a:hover,
		#secondary-nav a:focus {
			text-decoration: none !important;
			border-bottom: none !important;
		}

		#secondary-nav {
			width: 100%;
			transition: all 0.3s ease-in-out;
			height: 37px; 
			display: flex;
			align-items: center;
		}

			#secondary-nav ul {
				width: 100%;
				flex-wrap: nowrap;
			}

	</style>
</head>

<body style="min-height:113vh;">

	<div class="preloader-wrapper">
		<div class="preloader"></div>
	</div>

	<div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="offcanvasSearch" aria-labelledby="Search">
		<div class="offcanvas-header justify-content-center">
			<button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
		</div>

		<div class="offcanvas-body">
			<div class="order-md-last">
				<h4 class="text-primary text-uppercase mb-3">Search</h4>
				<div class="search-bar border rounded-pill py-0 px-2 border-dark-subtle">
					<form id="search-form" class="text-center d-flex align-items-center text-white" style="background-color: darkblue; padding: 5px;">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="text-white me-2 fs-6">
							<path fill="currentColor" d="M21.71 20.29L18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a1 1 0 0 0 1.42 0a1 1 0 0 0 0-1.39ZM11 18a7 7 0 1 1 7-7a7 7 0 0 1-7 7Z"></path>
						</svg>
						<input type="text" class="form-control form-control-sm border-0 bg-transparent text-white" placeholder="Search For More Than 10,000 Products">
					</form>
				</div>
			</div>
		</div>
	</div>



	<div class="sticky top-0 z-50">
		<header class="sticky-top top-0 left-0 w-full bg-gradient-to-r from-blue-900 to-blue-800  z-50 h-11 transition-all duration-300">
			<nav class="w-full h-full flex items-center justify-between px-3 md:px-6">
				<div class="flex-shrink-0">
					<img src="~/images/logo.png" alt="logo" class="h-10 rounded-sm">
				</div>

				<div class="flex-grow max-w-sm mx-4 md:mx-auto hidden sm:block">
					<form method="get" action="/AdminProducts/Products" class="relative group">
						<input type="text" name="search" placeholder="Search products..."
							   class="w-full py-1 pl-8 pr-3 text-sm rounded-lg focus:outline-none focus:ring-0 focus:bg-white/25 placeholder-white/75 transition duration-200"
							   style="background-color: rgba(255, 255, 255, 0.15); color: #ffffff;" />

						<svg class="absolute left-2 top-1/2 transform -translate-y-1/2 w-4 h-4 text-white/70 pointer-events-none"
							 fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
								  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
						</svg>
						<button type="submit" class="hidden"></button>
					</form>
				</div>

				<div class="flex items-center space-x-3 flex-shrink-0">
					<button aria-label="Search" data-bs-toggle="offcanvas" data-bs-target="#offcanvasSearch"
							class="sm:hidden p-1 rounded-full text-white hover:bg-blue-600 transition duration-200 shadow-lg hover:shadow-xl">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
								  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
						</svg>
					</button>

					<a  href="/Admin/Login" class=" hidden p-1 rounded-full text-white hover:bg-blue-600 transition duration-200 shadow-lg hover:shadow-xl">
						<svg class="w-6 h-6 md:w-7 md:h-7" fill="currentColor" viewBox="0 0 24 24">
							<path d="M15.71 12.71a6 6 0 1 0-7.42 0a10 10 0 0 0-6.22 8.18a1 1 0 0 0 2 .22a8 8 0 0 1 15.9 0a1 1 0 0 0 1 .89h.11a1 1 0 0 0 .88-1.1a10 10 0 0 0-6.25-8.19ZM12 12a4 4 0 1 1 4-4a4 4 0 0 1-4 4Z"></path>
						</svg>
					</a>

					<a asp-controller="Admin"
					   asp-action="Logout"
					   title="Logout"
					   class="p-1 rounded-full text-white hover:bg-blue-600 transition duration-200 shadow-lg hover:shadow-xl">
						<svg class="w-6 h-6 md:w-7 md:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
								  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
						</svg>
					</a>
				</div>
			</nav>

		</header>
	</div>

	<nav id="secondary-nav" class="w-full bg-white border-b border-gray-200 shadow-sm overflow-hidden">
		<div class="w-full mx-auto px-6 py-2">
			<div class="flex items-center justify-center">
				<ul class="flex items-center justify-center gap-x-8 md:gap-x-12 list-unstyled m-0 text-sm font-medium whitespace-nowrap">
					<ul class="flex items-center justify-center gap-x-8 md:gap-x-12 list-unstyled m-0 text-sm font-medium">

						<li>
							<a asp-action="AdminDashboard" asp-controller="Dashboard" class=" py-1 text-dark hover:text-primary transition duration-200">Dashboard</a>
						</li>

						<li>
							<a asp-action="Upload" asp-controller="UploadProduct" class=" py-1 text-dark hover:text-primary transition duration-200">Upload Products</a>
						</li>

						<li>
							<a asp-action="Products" asp-controller="AdminProducts" class=" py-1 text-dark hover:text-primary transition duration-200">Products</a>
						</li>

						<li>
							<a asp-action="PetAdoption" asp-controller="Adoption" class="py-1 text-dark hover:text-primary transition duration-200">Add Pets</a>
						</li>

						<li>
							<a asp-action="OurPets" asp-controller="Pets" class=" py-1 text-dark hover:text-primary transition duration-200">Pets</a>
						</li>

						<li>
							<a asp-action="RequestAdopt" asp-controller="RequestAdoption" class=" py-1 text-dark hover:text-primary transition duration-200">Adoption Requests</a>
						</li>

						<li>
							<a asp-action="ViewOrders" asp-controller="Orders" class="py-1 text-dark hover:text-primary transition duration-200">Orders</a>
						</li>

					</ul>
			</div>
		</div>
	</nav>



	@RenderBody()


	<script src="~/js/jquery-1.11.0.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"
			integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe"
			crossorigin="anonymous"></script>
	<script src="~/js/plugins.js"></script>
	<script src="~/js/script.js"></script>
	<script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
	@await RenderSectionAsync("Scripts", required: false)


</body>
</html>