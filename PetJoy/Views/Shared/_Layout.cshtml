    @RenderSection("Scripts", required: false)
    <div id="cartToast" class="cart-toast">
        added to your cart!
    </div>

    <script src="~/js/jquery-1.11.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe"
            crossorigin="anonymous"></script>
    <script src="~/js/plugins.js"></script>
    <script src="~/js/script.js"></script>
    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>

    <script>

        function updateCartSidebar() {

            $.get('@Url.Action("CartSidebar", "Cart")', function(data) {
                $('#cartSidebarContent').html(data);


                var itemCount = $(data).find('.item-count-badge').text().trim();
                $('#cartCount').text(itemCount || 0);
            });
        }

        function handleAddToCart(productId) {
            $('#cartSidebarContent').html('<div class="text-center p-5">Loading cart...</div>');

            $.post('@Url.Action("AddToCart", "Cart")', { id: productId }, function(response) {
                if (response.success) {
                    updateCartSidebar();
                    var cartOffcanvas = new bootstrap.Offcanvas(document.getElementById('offcanvasCart'));
                    cartOffcanvas.show();
                    console.log(response.message);
                } else {
                    alert("Error adding product: " + response.message);
                    updateCartSidebar();
                }
            }).fail(function(jqXHR, textStatus, errorThrown) {
                alert("An error occurred while adding to cart: " + errorThrown);
                updateCartSidebar();
            });
        }

        function setActiveLink() {

            var currentPath = window.location.pathname.toLowerCase().replace(/\/$/, "");

            var navLinks = document.querySelectorAll('.main-menu > div > div > div > ul a');

            navLinks.forEach(function(link) {
                if (link.id === 'petShopDropdown') {

                    return;
                }


                var linkUrl = link.getAttribute('href') ? link.getAttribute('href').toLowerCase().replace(/\/$/, "") : '';

                if (currentPath === linkUrl) {
                    link.classList.add('active-link');
                } else {
                    link.classList.remove('active-link');
                }
            });
        }

        $(document).ready(function() {
            updateCartSidebar();
            setActiveLink();


            $('#offcanvasCart').on('show.bs.offcanvas', function () {
                updateCartSidebar();
            });


            $(document).on('click', '.add-to-cart-btn', function(e) {
                e.preventDefault();
                var productId = $(this).data('product-id');
                if (productId) {
                    handleAddToCart(productId);
                } else {
                    console.error("Product ID not found for Add to Cart button.");
                }
            });
        });

        window.addEventListener('popstate', setActiveLink);



        document.addEventListener('DOMContentLoaded', function () {
            const toggle = document.getElementById('petShopDropdown');
            const menu = document.getElementById('petShopMenuContent');


            toggle.addEventListener('click', function(e) {
                e.preventDefault();
                const isHidden = menu.style.display === 'none' || menu.style.display === '';
                menu.style.display = isHidden ? 'block' : 'none';
                toggle.classList.toggle('active', isHidden);
            });


            document.addEventListener('click', function(e) {
                if (!toggle.contains(e.target) && !menu.contains(e.target)) {
                    menu.style.display = 'none';
                    toggle.classList.remove('active');
                }
            });
        });

                   let lastScrollTop = 0;
        const secondaryNav = document.getElementById('secondary-nav');
        const petShopMenu = document.getElementById('petShopMenuContent'); // Get the menu
        const petShopToggle = document.getElementById('petShopDropdown'); // Get the toggle button

        window.addEventListener('scroll', function() {
            let scrollTop = window.pageYOffset || document.documentElement.scrollTop;

            if (scrollTop > lastScrollTop && scrollTop > 50) {
                // Scrolling Down - Hide secondary nav
                secondaryNav.style.transform = 'translateY(-150%)';

                // Hide the shop menu if it's open when scrolling down
                if (petShopMenu) {
                    petShopMenu.style.display = 'none';
                    petShopToggle.classList.remove('active');
                }
            } else {
                // Scrolling Up - Show secondary nav
                secondaryNav.style.transform = 'translateY(0)';
            }
            lastScrollTop = scrollTop;
        });



        // Cart
                
        document.addEventListener("DOMContentLoaded", function () {

            const toast = document.getElementById("cartToast");

            document.querySelectorAll(".add-to-cart-btn").forEach(btn => {

                btn.addEventListener("click", function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    const productId = this.dataset.productId;

                    fetch('/Cart/AddToCartAjax', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId: productId })
                    })
                    .then(res => res.json())
                    .then(data => {

                        // Update cart count
                        document.getElementById("cartCount").innerText = data.count;

                        // Show toast
                        toast.classList.add("show");

                        // Hide after 2 seconds
                        setTimeout(() => {
                            toast.classList.remove("show");
                        }, 2000);
                    });
                });

            });
        });

    </script>

</body>
</html>