@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">

<head>
    <title>PetJoy - eCommerce Pet Shop Website </title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="format-detection" content="telephone=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="author" content="">
    <meta name="keywords" content="">
    <meta name="description" content="">

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet"
     integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M.SXH301p5ILy+dN9+nJOZ" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel="stylesheet" type="text/css" href="~/css/vendor.css">
    <link rel="stylesheet" type="text/css" href="~/css/style.css">


    <style>

        html {
            height: 100%;
        }

        body {
            font-family: 'Montserrat', sans-serif !important;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
            overflow-x: hidden !important;
            padding-top: 80px;
        }

        h1, h2, h3, h4, h5, h6, .main-menu a, .nav-link, button.filter-button, * {
            font-family: 'Montserrat', sans-serif !important;
        }

        #content-wrap {
            flex: 1;
            padding-top: 0px !important;
        }

        .text-primary, .hover:text-primary:hover, .nav-link.active, .footer-link:hover, .icon-item:hover, a:hover {
            color: #A3C7E8 !important;
        }


        .bg-primary, .badge.bg-primary, .btn-primary, .btn-primary:focus, .btn-primary:active, .btn-primary.active, .bg-secondary-hover:hover {
            background-color: #A3C7E8 !important;
            border-color: #A3C7E8 !important;
        }


            .btn-primary:hover {
                background-color: #B0D4F0 !important;
                border-color: #B0D4F0 !important;
            }

        .border-primary {
            border-color: #A3C7E8 !important;
        }


        .preloader:before,
        .preloader:after,
        .preloader {
            box-shadow: 0 2em 0 -1em #A3C7E8 !important;
        }

        li.social a:hover .social-icon {
            color: #FFF !important;
            border-color: #A3C7E8 !important;
            background-color: #A3C7E8 !important;
        }

        #petShopMenuContent {
            min-width: 350px !important;
            background: #fff;
            border-radius: 1.5rem;
            border: 1px solid #e0e7ff;
            box-shadow: 0 8px 18px rgba(0,0,0,0.12);
            padding: 1rem !important;
            position: absolute !important;
            top: 100% !important;
            left: 0 !important;
            transform: none !important;
            z-index: 9999 !important;
            display: none;
            margin-top: 5px;
        }

        .icon-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            justify-items: center;
        }

        .icon-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            color: #333;
            font-size: 0.95rem;
            transition: transform 0.2s ease-out, color 0.2s ease-out;
        }

            .icon-item:hover {
                transform: translateY(-5px);
                color: #A3C7E8 !important;
                text-decoration: none;
            }

        .icon-circle {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background-color: #e8f1f9;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 0.4rem;
            transition: background 0.2s, transform 0.2s ease-out;
        }

        .icon-item:hover .icon-circle {
            background-color: #A3C7E8;
            transform: scale(1.05);
        }

        .icon-circle i {
            font-size: 1.3rem;
            color: #A3C7E8;
            transition: color 0.2s;
        }

        .icon-item:hover .icon-circle i {
            color: #ffffff;
            animation: pulseIcon 0.5s ease-in-out;
        }

        @@keyframes pulseIcon {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.2);
            }

            100% {
                transform: scale(1);
            }
        }

        .icon-circle i.fas, .icon-circle i.fab {
            font-family: 'Font Awesome 6 Free' !important;
            font-weight: 900 !important;
            font-style: normal !important;
        }

        .icon-item span {
            text-align: center;
            display: block;
            max-width: 80px;
            white-space: normal;
            line-height: 1.2;
        }

        .main-menu a, .main-menu a:hover, .main-menu .nav-link, .main-menu .nav-link.active {
            text-decoration: none !important;
            border-bottom: none !important;
            box-shadow: none !important;
        }

        .main-menu {
            padding-top: 5px !important;
            padding-bottom: 5px !important;
        }

            .main-menu > div > div > div > ul a {
                padding-top: 0.25rem !important;
                padding-bottom: 0.25rem !important;
            }

            .main-menu a.active-link {
                font-weight: 700 !important;
                color: #A3C7E8 !important;
            }

            .main-menu a:not(.active-link) {
                opacity: 1;
                transition: opacity 0.2s ease-in-out, color 0.2s ease-in-out;
                color: #333 !important;
            }

                .main-menu a:not(.active-link):hover {
                    opacity: 0.8;
                    color: #B0D4F0 !important;
                }


        @@keyframes animation {
            0%, 80%, 100% {
                box-shadow: 0 2em 0 -1em #A3C7E8 !important;
            }

            40% {
                box-shadow: 0 2em 0 0 #A3C7E8 !important;
            }
        }

        @@media (max-width: 768px) {
            .main-menu ul {
                display: flex !important;
                flex-wrap: nowrap !important;
                overflow-x: auto !important;
                justify-content: flex-start !important;
                padding: 10px !important;
                -webkit-overflow-scrolling: touch;
            }

            .main-menu li {
                white-space: nowrap !important;
                margin-right: 1.5rem !important;
            }

            .main-menu ul::-webkit-scrollbar {
                display: none;
            }

            #petShopMenuContent {
                min-width: 300px !important;
                left: 50% !important;
                transform: translateX(-50%) !important;
                position: fixed !important;
                top: 20% !important;
            }
        }

        #secondary-nav a,
        #secondary-nav a:hover,
        #secondary-nav a:focus {
            text-decoration: none !important;
            border-bottom: none !important;
        }


        #secondary-nav {
            transition: transform 0.3s ease-in-out;
        }

        .cart-toast {
            position: fixed;
            top: 85px;
            right: 22px;
            background: #e6f4ff; 
            color: #1e5fa3; 
            padding: 12px 16px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 700;
            box-shadow: 0 6px 16px rgba(30, 95, 163, 0.18);
            opacity: 0;
            pointer-events: none;
            transform: translateY(-8px);
            transition: all 0.3s ease;
            z-index: 9999;
        }

            .cart-toast.show {
                opacity: 1;
                transform: translateY(0);
            }
        
    </style>

</head>

<body>

    <div class="preloader-wrapper">
        <div class="preloader">
        </div>
    </div>

    <div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="offcanvasCart" aria-labelledby="My Cart">
        <div class="offcanvas-header justify-content-center">
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div id="cartSidebarContent">
                <div class="text-center p-5">Loading cart...</div>
            </div>
        </div>
    </div>

    <div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="offcanvasSearch" aria-labelledby="Search">
        <div class="offcanvas-header justify-content-center">
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="order-md-last">
                <h4 class="text-primary text-uppercase mb-3">Search</h4>
                <div class="search-bar border rounded-pill py-0 px-2 border-dark-subtle">
                    <form id="search-form" class="text-center d-flex align-items-center text-white" style="background-color: #A3C7E8; padding: 5px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="text-white me-2 fs-6">
                            <path fill="currentColor" d="M21.71 20.29L18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a1 1 0 0 0 1.42 0a1 1 0 0 0 0-1.39ZM11 18a7 7 0 1 1 7-7a7 7 0 0 1-7 7Z"></path>
                        </svg>
                        <input type="text" name="search" class="form-control form-control-sm border-0 bg-transparent text-white" placeholder="Search For More Than 10,000 Products">
                    </form>
                </div>
            </div>
        </div>
    </div>



    <header class="fixed top-0 w-full z-50">

        <div class="bg-gradient-to-r from-blue-900 to-blue-800 h-11 shadow-md relative z-50">
            <nav class="w-full h-full flex items-center justify-between px-3 md:px-6">
                <div class="flex-shrink-0">
                    <a href="/" class="main-logo block">
                        <img src="~/images/logo.png" alt="logo" class="h-10 rounded-sm">
                    </a>
                </div>

                <div class="flex-grow max-w-sm mx-4 md:mx-auto hidden sm:block">
                    <form method="get" action="/ShopProduct/ShopProduct" class="relative group">
                        <input type="text" name="search" placeholder="Search products..."
                               class="w-full py-1 pl-8 pr-3 text-sm rounded-lg focus:outline-none focus:ring-0 focus:bg-white/25 placeholder-white/75 transition duration-200"
                               style="background-color: rgba(255, 255, 255, 0.15); color: #ffffff;" />
                        <svg class="absolute left-2 top-1/2 transform -translate-y-1/2 w-4 h-4 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </form>
                </div>

                <div class="flex items-center space-x-3">

                    <a href="/Admin/Login" title="Admin"
                       class="p-1 rounded-full text-white hover:bg-blue-600 transition duration-200 shadow-lg hover:shadow-xl">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M15.71 12.71a6 6 0 1 0-7.42 0a10 10 0 0 0-6.22 8.18a1 1 0 0 0 2 .22a8 8 0 0 1 15.9 0a1 1 0 0 0 1 .89h.11a1 1 0 0 0 .88-1.1a10 10 0 0 0-6.25-8.19ZM12 12a4 4 0 1 1 4-4a4 4 0 0 1-4 4Z"></path>
                        </svg>
                    </a>

                    <a href="#" class="p-1 rounded-full text-white position-relative hover:bg-blue-600 transition duration-200 shadow-lg hover:shadow-xl"
                       data-bs-toggle="offcanvas" data-bs-target="#offcanvasCart" aria-controls="offcanvasCart" aria-label="Shopping Cart">

                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="w-5 h-5">
                            <path fill="currentColor" d="M8.5 19a1.5 1.5 0 1 0 1.5 1.5A1.5 1.5 0 0 0 8.5 19ZM19 16H7a1 1 0 0 1 0-2h8.491a3.013 3.013 0 0 0 2.885-2.176l1.585-5.55A1 1 0 0 0 19 5H6.74a3.007 3.007 0 0 0-2.82-2H3a1 1 0 0 0 0 2h.921a1.005 1.005 0 0 1 .962.725l.155.545v.005l1.641 5.742A3 3 0 0 0 7 18h12a1 1 0 0 0 0-2Zm-1.326-9l-1.22 4.274a1.005 1.005 0 0 1-.963.726H8.754l-.255-.892L7.326 7ZM16.5 19a1.5 1.5 0 1 0 1.5 1.5a1.5 1.5 0 0 0-1.5-1.5Z"></path>
                        </svg>

                        <span id="cartCount" class="position-absolute badge rounded-circle bg-primary d-flex align-items-center justify-content-center border border-white"
                              style="top:-4px; left: 18px; height: 16px; width: 16px; font-size: 9px; padding: 0; line-height: 1;">0</span>
                    </a>
                </div>
            </nav>
        </div>

        <nav id="secondary-nav" class="bg-white border-b transition-transform duration-300 transform translate-y-0">
            <div class="max-w-full mx-auto px-6 py-2">
                <ul class="flex items-center justify-center gap-x-10 md:gap-x-16 list-unstyled m-0 text-sm font-medium">

                    <li>
                        <a asp-action="Index" asp-controller="Home" class=" py-1 text-dark hover:text-primary transition duration-200">Home</a>
                    </li>

                    <li class="nav-item dropdown" style="position: relative;">
                        <a href="#" id="petShopDropdown" class=" py-1 text-dark hover:text-primary transition duration-200">
                            Shop
                        </a>
                        <div class="dropdown-menu icon-circle-menu p-4" id="petShopMenuContent">
                            <div class="icon-grid">
                                <a asp-controller="CategoryPet" asp-action="PetTypeCategories" asp-route-petName="Cat" class="icon-item">
                                    <div class="icon-circle"><i class="fas fa-cat"></i></div>
                                    <span>Cat</span>
                                </a>
                                <a asp-controller="CategoryPet" asp-action="PetTypeCategories" asp-route-petName="Dog" class="icon-item">
                                    <div class="icon-circle"><i class="fas fa-dog"></i></div>
                                    <span>Dog</span>
                                </a>
                                <a asp-controller="CategoryPet" asp-action="PetTypeCategories" asp-route-petName="Bird" class="icon-item">
                                    <div class="icon-circle"><i class="fas fa-dove"></i></div>
                                    <span>Bird</span>
                                </a>
                                <a asp-controller="CategoryPet" asp-action="PetTypeCategories" asp-route-petName="Fish" class="icon-item">
                                    <div class="icon-circle"><i class="fas fa-fish"></i></div>
                                    <span>Fish</span>
                                </a>
                                <a asp-controller="CategoryPet" asp-action="PetTypeCategories" asp-route-petName="Small Pets" class="icon-item">
                                    <div class="icon-circle"><i class="fas fa-paw"></i></div>
                                    <span>Small Pets</span>
                                </a>
                            </div>
                        </div>
                    </li>

                    <li>
                        <a asp-action="PetCare" asp-controller="Care" class=" py-1 text-dark hover:text-primary transition duration-200">Care</a>
                    </li>

                    <li>
                        <a asp-action="Adopt" asp-controller="AdoptPet" class=" py-1 text-dark hover:text-primary transition duration-200">Adoption</a>
                    </li>

                    <li>
                        <a asp-controller="FooterLinks" asp-action="AboutUs" class=" py-1 text-dark hover:text-primary transition duration-200">About Us</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>



    <div id="content-wrap">
        @RenderBody()
    </div>

    <footer id="footer" class="mt-0 mb-0 text-white" style="background-color: #15406b !important;">
        <div class="container py-2">
            <div class="row pt-3">
                <div class="col-md-4 offset-md-1">
                    <div class="footer-menu">
                        <img src="~/images/logo.png" alt="logo" class="mb-2" style="max-width: 140px;">
                        <p class="fs-6 text-white mb-2">Follow our socials to get updates about our grand offers.</p>
                        <div class="social-links mt-3 mb-3">
                            <ul class="d-flex list-unstyled gap-3">
                                <li class="social">
                                    <a href="https://www.instagram.com/petjoy_2026/" class="text-white" target="_blank">
                                        <iconify-icon class="social-icon" icon="ri:instagram-fill" style="font-size: 20px;"></iconify-icon>
                                    </a>
                                </li>
                                <li class="social">
                                    <a href="https://www.facebook.com/profile.php?id=61583405444917" class="text-white" target="_blank">
                                        <iconify-icon class="social-icon" icon="ri:facebook-fill" style="font-size: 20px;"></iconify-icon>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="footer-menu">
                        <h3 class="h5 mb-2">Quick Links</h3>
                        <ul class="menu-list list-unstyled ps-0">
                            <li class="menu-item"><a asp-controller="Home" asp-action="Index" class="nav-link text-white footer-link p-0">Home</a></li>
                            <li class="menu-item"><a asp-controller="FooterLinks" asp-action="AboutUs" class="nav-link text-white footer-link p-0">About us</a></li>
                            <li class="menu-item"><a asp-controller="FooterLinks" asp-action="Services" class="nav-link text-white footer-link p-0">Services</a></li>
                            <li class="menu-item"><a asp-controller="FooterLinks" asp-action="ContactUs" class="nav-link text-white footer-link p-0">Contact Us</a></li>
                        </ul>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="footer-menu">
                        <h3 class="h5 mb-2">Help Center</h3>
                        <ul class="menu-list list-unstyled ps-0">
                            <li class="menu-item"><a asp-controller="FooterLinks" asp-action="FAQS" class="nav-link text-white footer-link p-0">FAQs</a></li>
                            <li class="menu-item"><a asp-controller="FooterLinks" asp-action="ReturnsandRefunds" class="nav-link text-white footer-link p-0">Returns & Refunds</a></li>
                            <li class="menu-item"><a asp-controller="FooterLinks" asp-action="Payment" class="nav-link text-white footer-link p-0">Payment</a></li>
                            <li class="menu-item"><a asp-controller="FooterLinks" asp-action="Guidelines" class="nav-link text-white footer-link p-0">Guidelines</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <hr class="mt-3 mb-2 border-secondary">
            <div class="row pb-2 text-white">
                <div class="col-md-6 copyright">
                    <p class="secondary-font m-0">© PetJoy - All Rights Reserved</p>
                </div>
                <div class="col-md-6 text-md-end">
                </div>
            </div>
        </div>
    </footer>

    <svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
        <defs>
            <symbol xmlns="http://www.w3.org/2000/svg" id="link" viewBox="0 0 24 24">
                <path fill="currentColor"
                      d="M12 19a1 1 0 1 0-1-1a1 1 0 0 0 1 1Zm5 0a1 1 0 1 0-1-1a1 1 0 0 0 1 1Zm0-4a1 1 0 1 0-1-1a1 1 0 0 0 1 1Zm-5 0a1 1 0 1 0-1-1a1 1 0 0 0 1 1Zm7-12h-1V2a1 1 0 0 0-2 0v1H8V2a1 1 0 0 0-2 0v1H5a3 3 0 0 0-3 3v14a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3V6a3 3 0 0 0-3-3Zm1 17a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9h16Zm0-11H4V6a1 1 0 0 1 1-1h1v1a1 1 0 0 0 2 0V5h8v1a1 1 0 0 0 2 0V5h1a1 1 0 0 1 1 1ZM7 15a1 1 0 1 0-1-1a1 1 0 0 0 1 1Zm0 4a1 1 0 1 0-1-1a1 1 0 0 0 1 1Z" />
            </symbol>
            <symbol xmlns="http://www.w3.org/2000/svg" id="arrow-right" viewBox="0 0 24 24">
                <path fill="currentColor"
                      d="M17.92 11.62a1 1 0 0 0-.21-.33l-5-5a1 1 0 0 0-1.42 1.42l3.3 3.29H7a1 1 0 0 0 0 2h7.59l-3.3 3.29a1 1 0 0 0 0 1.42a1 1 0 0 0 1.42 0l5-5a1 1 0 0 0 .21-.33a1 1 0 0 0 0-.76Z" />
            </symbol>
            <symbol xmlns="http://www.w3.org/2000/svg" id="category" viewBox="0 0 24 24">
                <path fill="currentColor"
                      d="M19 5.5h-6.28l-.32-1a3 3 0 0 0-2.84-2H5a3 3 0 0 0-3 3v13a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-10a3 3 0 0 0-3-3Zm1 13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-13a1 1 0 0 1 1-1h4.56a1 1 0 0 1 .95.68l.54 1.64a1 1 0 0 0 .95.68h7a1 1 0 0 1 1 1Z" />
            </symbol>
            <symbol xmlns="http://www.w3.org/2000/svg" id="calendar" viewBox="0 0 24 24">
                <path fill="currentColor"
                      d="M19 4h-2V3a1 1 0 0 0-2 0v1H9V3a1 1 0 0 0-2 0v1H5a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3Zm1 15a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-7h16Zm0-9H4V7a1 1 0 0 1 1-1h2v1a1 1 0 0 0 2 0V6h6v1a1 1 0 0 0 2 0V6h2a1 1 0 0 1 1 1Z" />
            </symbol>
            <symbol xmlns="http://www.w3.org/2000/svg" id="heart" viewBox="0 0 24 24">
                <path fill="currentColor"
                      d="M20.16 4.61A6.27 6.27 0 0 0 12 4a6.27 6.27 0 0 0-8.16 9.48l7.45 7.45a1 1 0 0 0 1.42 0l7.45-7.45a6.27 6.27 0 0 0 0-8.87Zm-1.41 7.46L12 18.81l-6.75-6.74a4.28 4.28 0 0 1 3-7.3a4.25 4.25 0 0 1 3 1.25a1 1 0 0 0 1.42 0a4.27 4.27 0 0 1 6 6.05Z" />
            </symbol>
            <symbol xmlns="http://www.w3.org/2000/svg" id="plus" viewBox="0 0 24 24">
                <path fill="currentColor"
                      d="M19 11h-6V5a1 1 0 0 0-2 0v6H5a1 1 0 0 0 0 2h6v6a1 1 0 0 0 2 0v-6h6a1 1 0 0 0 0-2Z" />
            </symbol>
            <symbol xmlns="http://www.w3.org/2000/svg" id="minus" viewBox="0 0 24 24">
                <path fill="currentColor" d="M19 11H5a1 1 0 0 0 0 2h14a1 1 0 0 0 0-2Z" />
            </symbol>
            <symbol xmlns="http://www.w3.org/2000/svg" id="cart" viewBox="0 0 24 24">
