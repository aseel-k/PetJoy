@model PetJoy.Models.FilterSide
@using Microsoft.AspNetCore.Http.Extensions

@{
    ViewData["Title"] = "Admin Shop Products";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var currentSearchTerm = Context.Request.Query["search"];
    var selectedPetTypeId = Model.SelectedPetTypeId.HasValue ? Model.SelectedPetTypeId.Value : 0; 

   var petTypes = new Dictionary<int, string>
    {
        { 0, "Filter by Pet Type" }, 
        { 1, "Cat" },               
        { 2, "Dog" },               
        { 3, "Fish" },              
        { 4, "Bird" },              
        { 5, "Small Pets" }         
    };
}


<div id="alertPlaceholder" class="container" style="position: fixed; top: 10px; right: 10px; z-index: 1050; max-width: 380px;">
</div>

<div class="container-fluid mb-5" style="padding-top: 40px;">
    <div class="row justify-content-center">
        <div class="col-lg-9 ps-4">

            @* Filter Section *@
            <div class="d-flex justify-content-between align-items-center mb-4">
                <p class="mb-0">Showing 1-@Model.Products.Count() of @Model.Products.Count() results</p>

                <div class="d-flex gap-2">
                    @* Pet Type Filter Dropdown *@
                    <select id="petTypeFilterDropdown" name="petTypeId" class="form-select w-auto">
                        @foreach (var petType in petTypes)
                        {
                            <option value="@petType.Key" @@(selectedPetTypeId == petType.Key ? "selected" : "")>
                                @petType.Value
                            </option>
                        }
                    </select>

                </div>
            </div>

            @* cards *@
            <div class="row">
                @foreach (var item in Model.Products)
                {
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100 text-center border-0 shadow">
                            <div class="card-img-top p-3 bg-white d-flex justify-content-center align-items-center"
                                 style="height: 250px;">
                                <img src="@Url.Content(item.Note)"
                                     class="img-fluid"
                                     alt="@(item.Name ?? "Product Image")"
                                     style="max-height: 100%; max-width: 100%; object-fit: contain;"
                                     loading="lazy" />
                            </div>

                            <div class="card-body d-flex flex-column justify-content-between text-center">
                                <div class="card-content">
                                    <h5 class="card-title text-dark product-name-source">@(item.Name ?? "Unnamed Product")</h5>
                                    <p class="card-text fw-bold text-dark product-price-source">@(item.Price?.ToString("F2") ?? "N/A") JD</p>
                                </div>

                                <div class="mt-auto d-flex justify-content-center gap-2">
                                    <button class="btn btn-sm btn-info text-white edit-product-btn" style="background-color:darkblue;"
                                            data-product-id="@item.ShopProductId"
                                            data-pet-type-id="@item.PetTypeId"
                                            data-brands-id="@item.BrandsId"
                                            data-shop-type-id="@item.ShopTypeId"
                                            title="Edit Product">
                                        Edit
                                    </button>

                                    <button class="btn btn-sm btn-danger delete-product-btn"
                                            data-product-id="@item.ShopProductId"
                                            title="Delete Product">
                                        Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* pagination *@
            @{
                int current = Model.CurrentPage;
                int total = Model.TotalPages;

                int startPage = Math.Max(1, current - 1);
                int endPage = Math.Min(total, current + 1);
            }
            <nav class="mt-4" aria-label="Page navigation">
                <ul class="pagination justify-content-center">

                    <li class="page-item @(current == 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("Products", "AdminProducts", new {
                                        page = current - 1,
                                        petTypeId = Model.SelectedPetTypeId,
                                        brandId = Model.SelectedBrandId,
                                        typeId = Model.SelectedTypeId,
                                        search = currentSearchTerm
                                    })">
                            &lt;
                        </a>
                    </li>

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == current ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("Products", "AdminProducts", new {
                                            page = i,
                                            petTypeId = Model.SelectedPetTypeId,
                                            brandId = Model.SelectedBrandId,
                                            typeId = Model.SelectedTypeId,
                                            search = currentSearchTerm
                                        })">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(current == total ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("Products", "AdminProducts", new {
                                            page = current + 1,
                                            petTypeId = Model.SelectedPetTypeId,
                                            brandId = Model.SelectedBrandId,
                                            typeId = Model.SelectedTypeId,
                                            search = currentSearchTerm
                                        })">
                            &gt;
                        </a>
                    </li>

                </ul>
            </nav>

        </div>
    </div>
</div>


<div class="modal fade" id="editProductModal" tabindex="-1" aria-labelledby="editProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white" style="background-color: darkblue !important;">
                <h5 class="modal-title text-white" id="editProductModalLabel">
                    <i class="fas fa-edit me-2"></i> Edit Product Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="editProductForm" enctype="multipart/form-data">
                <div class="modal-body p-4">

                    <input type="hidden" id="editProductId" name="ShopProductId" value="" />
                    <input type="hidden" id="editProductNote" name="Note">
                    <div class="mb-3">
                        <label for="editProductName" class="form-label visually-hidden">Product Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-tag"></i>
                            </span>
                            <input type="text" class="form-control form-control-lg border-start-0" id="editProductName" name="Name" placeholder="Product Name" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="editPetTypeId" class="form-label visually-hidden">Pet Type</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-heart"></i>
                            </span>
                            <select class="form-select form-select-lg border-start-0" id="editPetTypeId" name="PetTypeId" >
                                <option value="" data-name="Select Pet Type" disabled>Select Pet Type</option>
                                <option value="1" data-name="Cat">Cat</option>
                                <option value="2" data-name="Dog">Dog</option>
                                <option value="3" data-name="Fish">Fish</option>
                                <option value="4" data-name="Bird">Bird</option>
                                <option value="5" data-name="Small Pets">Small Pets</option>
                            </select>
                        </div>
                    </div>

                   <div class="mb-3">
                        <label for="editBrandId" class="form-label visually-hidden">Brand</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-medal"></i>
                            </span>
                            <select class="form-select form-select-lg border-start-0" id="editBrandId" name="BrandsId" required>
                               <option value="" data-name="Select Brand" disabled>Select Brand</option>
                                <option value="" data-name="No Brand">No Brand</option>
                                <option value="1" data-name="Royal Canin">Royal Canin</option>
                                <option value="2" data-name="Taste Of The Wild">Taste Of The Wild</option>
                                <option value="3" data-name="Monge">Monge</option>
                                <option value="4" data-name="Bewi Cat">Bewi Cat</option>
                                <option value="5" data-name="Montego">Montego</option>
                                <option value="6" data-name="Henrys">Henrys</option>
                                <option value="7" data-name="Duvo">Duvo</option>
                                <option value="8" data-name="Tetra">Tetra</option>
                                <option value="9" data-name="Harrison">Harrison</option>
                                <option value="10" data-name="Kiki Excellent">Kiki Excellent</option>
                            </select>
                        </div>
                    </div>

                   <div class="mb-3">
                        <label for="editTypeId" class="form-label visually-hidden">Category</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-store"></i>
                            </span>
                            <select class="form-select form-select-lg border-start-0" id="editTypeId" name="ShopTypeId" required>
                                <option value="" data-name="Select Category" disabled>Select Category</option>
                                <option value="1" data-name="Food & Treats">Food & Treats </option>
                                <option value="2" data-name="Clothes">Clothes</option>
                                <option value="3" data-name="Toys">Toys </option>
                                <option value="4" data-name="Litter">Litter </option>
                                <option value="5" data-name="Bowls & Containers">Bowls & Containers</option>
                                <option value="6" data-name="Collar">Collar </option>
                                <option value="7" data-name="Grooming">Grooming </option>
                                <option value="8" data-name="Beds">Beds</option>
                                <option value="9" data-name="Travel Crates">Travel Crates</option>
                                <option value="10" data-name="Cages">Cages</option>
                                <option value="11" data-name="Health & Wellness">Health & Wellness</option>
                                <option value="12" data-name="Aquariums">Aquariums</option>
                                <option value="13" data-name="Accessories">Accessories</option>
                            </select>
                        </div>
                    </div>


                    <div class="mb-3">
                        <label for="editProductPrice" class="form-label visually-hidden">Price (JD)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-money-bill-wave"></i>
                            </span>
                            <input type="number" step="0.01" class="form-control form-control-lg border-start-0" id="editProductPrice" name="Price" placeholder="Price (JD)" >
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="saveEditButton" style="background-color: darkblue; padding: 5px 10px; font-size:25px ;line-height: 1; ">
                        <span>  <i class="fas fa-save " style="block-size:15px;"></i> <span style="font-size:20px"> Save Changes</span></span>

                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-labelledby="deleteConfirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white" style="background-color: darkblue !important;">
                <h5 class="modal-title text-white" id="deleteConfirmationModalLabel">Confirm Product Deletion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body text-center">
                <p class="fs-5 fw-bold">Are you sure you want to delete this product?</p>

                <input type="hidden" id="productToDeleteId" value="" />

                <div id="productDetails" class="my-4 d-flex flex-column align-items-center">

                    <img id="productImage" src="" alt="Product Image"
                         class="img-fluid shadow-sm"
                         style="max-width: 150px; height: auto; object-fit: contain; border-radius: 5px; border: 1px solid #ccc; margin-bottom: 10px;">

                    <p class="h5 mt-2 mb-0" id="productName">...</p>
                    <p class="text-black fw-bold fs-6" id="productPrice">...</p>
                </div>

            </div>

            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-danger" id="confirmDeleteButton">
                    <i class="fas fa-trash-alt me-2"></i> Confirm Delete
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><span style="font-size:15px">Cancel</span></button>
            </div>

        </div>
    </div>
</div>



<div class="modal fade" id="productDetailsModal" tabindex="-1" aria-labelledby="productDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content text-center" style="border-radius: 15px; background-color: #f7f7f7;">
            <div class="modal-header border-0 pb-0 d-flex justify-content-end">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-0 px-4">
                <div class="d-flex align-items-center justify-content-center mb-3">
                    <i class="fas fa-check-circle me-2" style="font-size: 20px; color: darkgreen !important;"></i>
                    <h5 class="modal-title fw-bold m-0" id="productDetailsModalLabel">Updated Successfully!</h5>
                </div>
                
                <img id="successProductImage" src="" alt="Product Image"
                     class="img-fluid shadow mb-4"
                     style="max-width: 150px; height: auto; object-fit: cover; border-radius: 8px; border: 2px solid #fff; display: block; margin: 0 auto;">

                <div id="successProductDetailsContainer" class="d-flex flex-column align-items-center">
                    
                    <div class="w-100 text-start px-3 py-3 bg-white rounded shadow-sm border border-light">
                        <p class="mb-1 small">
                            <strong class="me-1 " style="color:darkblue">Name:</strong> <span id="successProductName">...</span>
                        </p>
                        <p class="mb-1 small">
                            <strong class="me-1 " style="color:darkblue">Price:</strong> <span id="successProductPrice" class="fw-bold">...</span> JD
                        </p>
                        <hr class="my-1">
                        <p class="mb-1 small">
                            <strong class="me-1 " style="color:darkblue">Pet Type:</strong> <span id="successProductPetType">...</span>
                        </p>
                        <p class="mb-1 small">
                            <strong class="me-1 " style="color:darkblue">Brand:</strong> <span id="successProductBrand">...</span>
                        </p>
                        <p class="mb-0 small">
                            <strong class="me-1" style="color:darkblue">Category:</strong> <span id="successProductCategory">...</span>
                        </p>
                    </div>

                </div>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-center">
                <button type="button" 
                        class="btn btn-primary d-flex align-items-center justify-content-center" 
                        data-bs-dismiss="modal" 
                        style="background-color: darkblue; height: 35px; min-width: 100px;">
                    <span style="font-size: 16px; margin: 0;">Close</span>
                </button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="deleteSuccessModal" tabindex="-1" aria-labelledby="deleteSuccessModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content text-center" style="border-radius: 15px; background-color: #f7f7f7;">
            <div class="modal-header border-0 pb-0 d-flex justify-content-end">
