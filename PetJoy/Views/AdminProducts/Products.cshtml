                <div id="deletedProductDetailsContainer" class="d-flex flex-column align-items-center">
                    
                    <div class="w-100 text-start px-3 py-3 bg-white rounded shadow-sm border border-light">
                        <p class="mb-1 small">
                            <strong class="me-1 " style="color:darkblue">Name:</strong> <span id="deletedProductName">...</span>
                        </p>
                        <p class="mb-1 small">
                            <strong class="me-1 " style="color:darkblue">Price:</strong> <span id="deletedProductPrice" class="fw-bold">...</span> JD
                        </p>
                        <hr class="my-1">
                        <p class="mb-1 small">
                            <strong class="me-1 " style="color:darkblue">Pet Type:</strong> <span id="deletedProductPetType">...</span>
                        </p>
                        <p class="mb-1 small">
                            <strong class="me-1 " style="color:darkblue">Brand:</strong> <span id="deletedProductBrand">...</span>
                        </p>
                        <p class="mb-0 small">
                            <strong class="me-1" style="color:darkblue">Category:</strong> <span id="deletedProductCategory">...</span>
                        </p>
                    </div>

                </div>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-center">
                <button type="button" 
                        class="btn btn-primary d-flex align-items-center justify-content-center" 
                        data-bs-dismiss="modal" 
                        style="background-color: darkblue; height: 35px; min-width: 100px;">
                    <span style="font-size: 16px; margin: 0;">Close</span>
                </button>
            </div>
        </div>
    </div>
</div>



@section Scripts {

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-easing/1.4.1/jquery.easing.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/js/all.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9Fh2sF7Q8C6F2f3Bf2rB5N/zCq4g0gO1E6t9Jg0" crossorigin="anonymous"></script>

    <script>
        $(document).ready(function () {
            console.log("✅ JS Loaded Successfully");

            
            if ($('#petTypeFilterDropdown').length) {
                $('#petTypeFilterDropdown').on('change', function () {
                    var petTypeId = $(this).val();
                    var currentUrl = new URL(window.location.href, window.location.origin);

                    if (petTypeId && petTypeId !== '0') {
                        currentUrl.searchParams.set('petTypeId', petTypeId);
                    } else {
                        currentUrl.searchParams.delete('petTypeId');
                    }

                    currentUrl.searchParams.set('page', '1');
                    
                    currentUrl.searchParams.delete('sortOrder'); 

                    window.location.href = currentUrl.href;
                });
            }


            // ALERT FUNCTION 
            function showSimpleAlert(message, type = 'success') {

                var alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
                var iconHtml = type === 'success' ? '<i class="fas fa-check-circle me-2"></i>' : '<i class="fas fa-times-circle me-2"></i>';
                if (type === 'danger') {
                    iconHtml = '<i class="fas fa-times-circle me-2"></i>';
                }

                var alertHtml = `
                    <div class="alert ${alertClass} alert-dismissible fade show shadow" role="alert" style="border-left: 5px solid ${type === 'success' ? 'darkgreen' : 'darkred'};">
                        ${iconHtml} ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;

                $('#alertPlaceholder').append(alertHtml);

                setTimeout(function () {
                    $('.alert').last().alert('close');
                }, 3000);
            }

            // EDIT PRODUCT (Modal Filler - Unchanged)
            $(document).on('click', '.edit-product-btn', function (e) {
                e.preventDefault();

                var btn = $(this);
                var card = btn.closest('.card');

                $('#editProductId').val(btn.data('product-id'));
                $('#editProductName').val(card.find('.product-name-source').text().trim());

                var price = card.find('.product-price-source').text().replace(' JD', '');
                $('#editProductPrice').val(parseFloat(price).toFixed(2));

                var img = card.find('.card-img-top img').attr('src');
                $('#editProductNote').val(img); // Save old path for AJAX

                // Set dropdown values
                $('#editPetTypeId').val(btn.data('pet-type-id'));
                $('#editBrandId').val(btn.data('brands-id'));
                $('#editTypeId').val(btn.data('shop-type-id'));

                new bootstrap.Modal(document.getElementById('editProductModal')).show();
            });

            // SAVE EDIT 
            if ($('#editProductForm').length) {

                $('#editProductForm').on('submit', function (e) {
                    e.preventDefault();

                    var saveBtn = $('#saveEditButton');
                    saveBtn.prop('disabled', true).html('Saving...');

                    var updatedProductDetails = {
                        name: $('#editProductName').val(),
                        price: parseFloat($('#editProductPrice').val()).toFixed(2),
                        petTypeId: $('#editPetTypeId').val(),
                        brandId: $('#editBrandId').val(),
                        typeId: $('#editTypeId').val(),
                        imagePath: $('#editProductNote').val() 
                    };

                    $.ajax({
                        url: '@Url.Action("EditProduct", "AdminProducts")',
                        type: 'POST',
                        data: new FormData(this),
                        processData: false,
                        contentType: false,

                        success: function (res) {

                            bootstrap.Modal.getInstance(document.getElementById('editProductModal')).hide();

                            if (!res.success) {
                                showSimpleAlert(res.message, 'danger');
                                return;
                            }

                            var id = $('#editProductId').val();
                            var card = $('.edit-product-btn[data-product-id="' + id + '"]').closest('.card');

                            card.find('.product-name-source').text(updatedProductDetails.name);
                            card.find('.product-price-source').text(updatedProductDetails.price + ' JD');

                            var editButton = card.find('.edit-product-btn');
                            editButton.data('pet-type-id', updatedProductDetails.petTypeId);
                            editButton.data('brands-id', updatedProductDetails.brandId);
                            editButton.data('shop-type-id', updatedProductDetails.typeId);

                            if (res.newImagePath) {
                                card.find('img').attr('src', res.newImagePath);
                                updatedProductDetails.imagePath = res.newImagePath; 
                            }
                            
                            displaySuccessModal(updatedProductDetails);
                        },

                        error: function () {
                            bootstrap.Modal.getInstance(document.getElementById('editProductModal')).hide();
                            showSimpleAlert('Server error occurred', 'danger');
                        },

                        complete: function () {
                            saveBtn.prop('disabled', false).html('<span>  <i class="fas fa-save " style="block-size:15px;"></i> <span style="font-size:20px"> Save Changes</span></span>');
                        }
                    });
                });
            }

            // FUNCTION TO DISPLAY SUCCESS MODAL
            function displaySuccessModal(details) {
                var petTypeName = $(`#editPetTypeId option[value="${details.petTypeId}"]`).data('name').trim() || 'N/A';
                var brandName = $(`#editBrandId option[value="${details.brandId}"]`).data('name').trim() || 'N/A';
                var categoryName = $(`#editTypeId option[value="${details.typeId}"]`).data('name').trim() || 'N/A';

                $('#successProductImage').attr('src', details.imagePath);
                $('#successProductName').text(details.name);
                $('#successProductPrice').text(details.price);
                $('#successProductPetType').text(petTypeName);
                $('#successProductBrand').text(brandName);
                $('#successProductCategory').text(categoryName);

                new bootstrap.Modal(document.getElementById('productDetailsModal')).show();
            }

            // DELETE PRODUCT (Modal Filler)
            $(document).on('click', '.delete-product-btn', function (e) {
                e.preventDefault();

                var btn = $(this);
                var card = btn.closest('.card');
                var productId = btn.data('product-id');

                var name = card.find('.product-name-source').text().trim();
                var price = card.find('.product-price-source').text().trim();
                var imagePath = card.find('.card-img-top img').attr('src');
                
                var editBtn = card.find('.edit-product-btn');
                var petTypeId = editBtn.data('pet-type-id');
                var brandId = editBtn.data('brands-id');
                var typeId = editBtn.data('shop-type-id');
                
                var petTypeName = $(`#editPetTypeId option[value="${petTypeId}"]`).data('name').trim() || 'N/A';
                var brandName = $(`#editBrandId option[value="${brandId}"]`).data('name').trim() || 'N/A';
                var categoryName = $(`#editTypeId option[value="${typeId}"]`).data('name').trim() || 'N/A';


                $('#productToDeleteId').val(productId);
                $('#productName').text(name);
                $('#productPrice').text(price);
                $('#productImage').attr('src', imagePath);

                $('#confirmDeleteButton').data({
                    'product-id': productId,
                    'name': name,
                    'price': price.replace(' JD', ''),
                    'image-path': imagePath,
                    'pet-type-name': petTypeName,
                    'brand-name': brandName,
                    'category-name': categoryName
                });

                new bootstrap.Modal(document.getElementById('deleteConfirmationModal')).show();
            });


            // CONFIRM DELETE 
            $('#confirmDeleteButton').on('click', function () {
                var deleteBtn = $(this);
                var productId = deleteBtn.data('product-id');
                
                var deletedProductDetails = deleteBtn.data(); 

                deleteBtn.prop('disabled', true).html('Deleting...');

                $.ajax({
                    url: '@Url.Action("DeleteProduct", "AdminProducts")',
                    type: 'POST',
                    data: { id: productId },

                    success: function (res) {
                        bootstrap.Modal.getInstance(document.getElementById('deleteConfirmationModal')).hide();

                        if (res.success) {
                            $('.edit-product-btn[data-product-id="' + productId + '"]').closest('.col-md-6').remove();
                            displayDeleteSuccessModal(deletedProductDetails);
                        } else {
                            showSimpleAlert(res.message, 'danger');
                        }
                    },

                    error: function () {
                        bootstrap.Modal.getInstance(document.getElementById('deleteConfirmationModal')).hide();
                        showSimpleAlert('Server error occurred during deletion.', 'danger');
                    },

                    complete: function () {
                        deleteBtn.prop('disabled', false).html('<i class="fas fa-trash-alt me-2"></i> Confirm Delete');
                    }
                });
            });

            // FUNCTION TO DISPLAY DELETE SUCCESS MODAL
            function displayDeleteSuccessModal(details) {
                
                $('#deletedProductImage').attr('src', details.imagePath);
                $('#deletedProductName').text(details.name);
                $('#deletedProductPrice').text(parseFloat(details.price).toFixed(2) + ' JD');
                $('#deletedProductPetType').text(details.petTypeName);
                $('#deletedProductBrand').text(details.brandName);
                $('#deletedProductCategory').text(details.categoryName);

                new bootstrap.Modal(document.getElementById('deleteSuccessModal')).show();
            }

        });
    </script>
}