@model PetJoy.Models.LoginViewModel

@{
    ViewBag.Title = "Login";
    Layout = null;
}

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Login</title>

    <link rel="stylesheet" type="text/css" href="~/css/vendor.css">
    <link rel="stylesheet" type="text/css" href="~/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #f0f4f8 0%, #d7e1ec 100%);
            min-height: 100vh;
        }

        :root {
            --primary-blue: #1e5287;
            --secondary-blue: #4a90e2;
            --light-bg: #f5f7fa;
            --lighter-bg: #ffffff;
            --shadow-color: rgba(30, 82, 135, 0.15);
            --border-color: #e1e5ea;
        }

        .main-container {
            min-height: 100vh;
            padding: 3rem 0;
        }


        .card-custom {
            width: 500px;
            border: none;
            border-radius: 24px;
            background-color: var(--lighter-bg);
            box-shadow: 0 18px 40px var(--shadow-color);
            transition: transform 0.3s ease;
        }

        .title-text {
            color: var(--primary-blue);
            font-weight: 700;
            font-family: 'Fredoka', sans-serif;
            font-size: 2.5rem;
        }


        .form-control {
            border-radius: 14px;
            border: 1px solid var(--border-color);
            padding: 1.2rem 1rem;
            background-color: #fff;
            height: 60px;
            color: var(--primary-blue);
            font-weight: 500;
            box-shadow: none;
            transition: all 0.3s;
        }

            .form-control:focus {
                border-color: var(--secondary-blue);
                box-shadow: 0 0 0 4px rgba(74, 144, 226, 0.15);
                background-color: #fff;
            }


        .form-floating > label {
            padding-left: 1rem;
            color: #8898aa;
            font-size: 0.95rem;
            transition: all 0.2s ease-in-out;
            pointer-events: none;
            z-index: 3;
        }

            .form-floating > label > i {
                color: var(--secondary-blue) !important;
                font-weight: bold;
                margin-right: 8px;
                font-size: 1.2rem;
                vertical-align: middle;
            }


        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            opacity: 1;
            color: var(--primary-blue);
            transform: scale(0.8) translateY(-1.75rem) translateX(0.15rem);
            font-weight: 600;
            background-color: transparent !important;
            padding: 0;
            border-radius: 0;
            z-index: 10;
        }

        .btn-primary-custom {
            background-color: var(--primary-blue);
            border: none;
            border-radius: 14px;
            padding: 16px;
            font-weight: 700;
            font-size: 1.15rem;
            box-shadow: 0 8px 25px rgba(30, 82, 135, 0.4);
            transition: all 0.3s ease;
            color: #ffffff !important;
        }

            .btn-primary-custom:hover {
                background-color: var(--primary-blue);
                box-shadow: 0 8px 25px rgba(30, 82, 135, 0.4);
                transform: none;
            }

            .btn-primary-custom:active,
            .btn-primary-custom:focus {
                background-color: var(--primary-blue) !important;
                box-shadow: 0 8px 25px rgba(30, 82, 135, 0.4) !important;
            }

    </style>


    <div class="d-flex justify-content-center align-items-center main-container">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-12 d-flex justify-content-center">

                    <div class="card card-custom p-4 p-md-5">

                        <div class="text-center mb-3">
                            <h2 class="title-text mb-2">
                                <i class="bi bi-person-circle me-2"></i>Admin Login
                            </h2>
                            <p class="text-muted" style="font-size: 1.0em;"> <b>PetJoy</b> Admin Panel</p>
                        </div>

                        <form asp-action="Login" method="post">
                            <div class="row g-4">
                                <div class="col-12">
                                    <div class="form-floating">
                                        <input asp-for="Username" class="form-control" id="usernameInput" placeholder="Username" required />
                                        <label for="usernameInput"><i class="bi bi-person-fill"></i>Username</label>
                                    </div>
                                    <span asp-validation-for="Username" class="text-danger"></span>
                                </div>

                                <div class="col-12">
                                    <div class="form-floating">
                                        <input asp-for="Password" class="form-control" type="password" id="passwordInput" placeholder="Password" required />
                                        <label for="passwordInput"><i class="bi bi-lock-fill"></i>Password</label>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>

                            </div>

                            @if (ViewBag.ErrorMessage != null)
                            {
                                <div class="alert alert-danger mt-4">@ViewBag.ErrorMessage</div>
                            }

                            <div class="text-center mt-5">
                                <button type="submit" class="btn btn-primary-custom w-100">
                                    Login
                                </button>

                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
