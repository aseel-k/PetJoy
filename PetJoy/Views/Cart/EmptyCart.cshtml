@{
    ViewData["Title"] = "Your Cart is empty";
}

<style>
    @@keyframes cart-wiggle {
        0% {
            transform: translateX(0);
        }

        25% {
            transform: translateX(20px);
        }

        50% {
            transform: translateX(-20px);
        }

        75% {
            transform: translateX(20px);
        }

        100% {
            transform: translateX(0);
        }
    }

    .animated-cart-img {
        animation: cart-wiggle 1.5s ease-in-out infinite alternate;
        filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1));
    }
</style>

<div class="container text-center py-6" style="max-width: 900px;">
    <div class="p-5 bg-white shadow-lg border rounded-3">
        <h1 class="fw-bold mb-3" style="font-size: 2.2rem;">Your cart is empty.</h1>

        <p class="text-muted">Looks like you haven't added anything yet.</p>

        <div class="d-flex justify-content-center my-5">
            <img src="~/images/EmptyCart.png"
                 alt="Empty Cart"
                 style="width: 150px; height: auto;"
                 class="animated-cart-img" />
        </div>

        <a asp-action="ShopProduct" asp-controller="ShopProduct" class="btn text-white w-50 py-2"
           style="background-color: #15406b !important; border-color: #15406b !important; font-size: 1.1rem;">
            Continue Shopping
        </a>
    </div>
</div>