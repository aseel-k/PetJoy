	<script src="https://js.stripe.com/v3/"></script>
	<script>
		document.addEventListener("DOMContentLoaded", async function () {
		  const creditCardRadio = document.getElementById("onlinePayment");
		  const codRadio = document.getElementById("cashOnDelivery");

		  const stripeBox = document.getElementById("stripeCardBox");
		  const errorBox = document.getElementById("stripe-error");
		  const form = document.getElementById("payment-form") || document.querySelector("form");

		  const stripe = Stripe("@ViewBag.StripePk");

		  let elements = null;
		  let clientSecret = null;

		  let cardNumber = null;
		  let cardExpiry = null;
		  let cardCvc = null;

		  async function initStripe() {
			if (clientSecret) return;

			const res = await fetch("/Checkout/CreateStripeIntent", { method: "POST" });
			const data = await res.json();
			clientSecret = data.clientSecret;

			elements = stripe.elements({
				locale: "en" ,
				 wallets: { link: "never" }
			});

			const baseStyle = {
			  style: {
				base: {
				  fontSize: "16px",
				  color: "#1a1a1a",
				  "::placeholder": { color: "#a0a0a0" }
				}
			  }
			};

			cardNumber = elements.create("cardNumber", {
			  ...baseStyle,
			  disableLink: true
			});

			cardExpiry = elements.create("cardExpiry", baseStyle);
			cardCvc = elements.create("cardCvc", baseStyle);

			cardNumber.mount("#card-number");
			cardExpiry.mount("#card-expiry");
			cardCvc.mount("#card-cvc");

			// Errors
			[cardNumber, cardExpiry, cardCvc].forEach(el => {
			  el.on("change", (event) => {
				errorBox.textContent = event.error ? event.error.message : "";
			  });
			});
		  }

		  async function togglePaymentUi() {
			if (creditCardRadio.checked) {
			  stripeBox.style.display = "block";
			  await initStripe();
			} else {
			  stripeBox.style.display = "none";
			}
		  }

		  creditCardRadio.addEventListener("change", togglePaymentUi);
		  codRadio.addEventListener("change", togglePaymentUi);
		  await togglePaymentUi();

		  form.addEventListener("submit", async (e) => {
			if (!creditCardRadio.checked) return;

			e.preventDefault();
			errorBox.textContent = "";

			const { error, paymentIntent } = await stripe.confirmCardPayment(clientSecret, {
			  payment_method: {
				card: cardNumber,
				billing_details: {
				  name: (document.getElementById("FirstName")?.value || "") + " " + (document.getElementById("LastName")?.value || ""),
				  email: document.getElementById("Email")?.value || ""
				}
			  }
			});

			if (error) {
			  errorBox.textContent = error.message;
			  return;
			}
			const hidden = document.createElement("input");
			hidden.type = "hidden";
			hidden.name = "StripePaymentIntentId";
			hidden.value = paymentIntent.id;
			form.appendChild(hidden);
			form.submit();
		  });
		});
	</script>

