<div class="container checkout-container">
	<div class="col-left">
		@* start for Stripe *@
		<form id="payment-form" asp-action="PlaceOrder" method="post" class="needs-validation" novalidate>
			@* end for Stripe *@
			<h2 class="mb-4">Contact</h2>
			<div class="row g-3 mb-5">

				<!-- First Name -->
				<div class="col-md-6">
					<div class="form-floating">
						<input asp-for="FirstName" class="form-control" placeholder="First Name" required />
						<label asp-for="FirstName">First Name <span style="color:red">*</span></label>

						<div class="invalid-feedback">
							Enter your first name.
						</div>
					</div>
				</div>

				<!-- Last Name -->
				<div class="col-md-6">
					<div class="form-floating">
						<input asp-for="LastName" class="form-control" placeholder="Last Name" required />
						<label asp-for="LastName">Last Name <span style="color:red">*</span></label>

						<div class="invalid-feedback">
							Enter your last name.
						</div>
					</div>
				</div>

				<!-- Email -->
				<div class="col-md-6">
					<div class="form-floating">
						<input asp-for="Email" class="form-control" placeholder="Email" required />
						<label asp-for="Email">Email <span style="color:red">*</span></label>

						<div class="invalid-feedback">
							Enter a valid email.
						</div>
					</div>
				</div>

				<!-- Phone -->
				<div class="col-md-6">
					<div class="form-floating">
						<input asp-for="PhoneNumber" class="form-control" placeholder="Phone Number" required />
						<label asp-for="PhoneNumber">Phone Number <span style="color:red">*</span></label>

						<div class="invalid-feedback">
							Enter your phone number.
						</div>
					</div>
				</div>
			</div>

			@* Delivery *@
			<h2 class="mb-4">Delivery</h2>
			<div class="row g-3 mb-5">
				<div class="form-floating mb-1">
					<input asp-for="Address" class="form-control" placeholder="Address" required />
					<label asp-for="Address">Address <span style="color:red">*</span> </label>

					<div class="invalid-feedback">Enter your shipping address.</div>
				</div>

				<div class="row g-3">
					<div class="col-md-6">
						<div class="form-floating mb-3">
							<input asp-for="Country" class="form-control" value="Jordan" readonly />
							<label asp-for="Country">Country <span style="color:red">*</span></label>
						</div>
					</div>

					<div class="col-md-6">
						<div class="form-floating">
							<input asp-for="PostalCode" class="form-control" placeholder="Postal Code" />
							<label asp-for="PostalCode">Postal Code </label>
						</div>
					</div>
				</div>

				<div class="form-floating mb-3">
					<input asp-for="Apartment" class="form-control" placeholder="Apartment" />
					<label asp-for="Apartment">Apartment  </label>
				</div>

				<div class="col-12">
					<label for="City" class="form-label">City <span style="color:red">*</span></label>
					<select asp-for="City" class="form-select" required>
						<option value="" disabled selected hidden>Select a City</option>
						<option>Amman</option>
						<option>Balqa</option>
						<option>Irbid</option>
						<option>Jerash</option>
						<option>Ajloun</option>
						<option>Karak</option>
						<option>Mafraq</option>
						<option>Zarqa</option>
						<option>Madaba</option>
						<option>Tafilah</option>
						<option>Ma'an</option>
						<option>Aqaba</option>
					</select>

					<div class="invalid-feedback">
						Select a valid city.
					</div>
				</div>
			</div>

			@* Payment Method *@
			<h2 class="mb-4">Payment Method <span style="color:red">*</span></h2>
			<div class="payment-options d-flex gap-5">
				<div class="form-check">
					<input asp-for="SelectedPaymentMethodId" class="form-check-input" type="radio" value="2" id="onlinePayment" />
					<label class="form-check-label" for="onlinePayment">Credit Card </label>
				</div>
				<div class="form-check">
					<input asp-for="SelectedPaymentMethodId" class="form-check-input" type="radio" value="1" id="cashOnDelivery" checked />
					<label class="form-check-label" for="cashOnDelivery">Cash on Delivery</label>
				</div>
			</div>

			@* start for Stripe *@
			@* <div id="creditCardFields" style="padding-top: 20px; margin-top: 20px;">
				<div class="row g-3">
					<div class="col-md-6">
						<label asp-for="CardNumber" class="form-label">Card Number</label>
						<input asp-for="CardNumber" class="form-control" placeholder="" />
						<div class="invalid-feedback">
							Card number is required.
						</div>
					</div>
					<div class="col-md-6">
						<label asp-for="CardHolder" class="form-label">Card Holder</label>
						<input asp-for="CardHolder" class="form-control" placeholder="" />
					</div>
					<div class="col-md-6">
						<label asp-for="ExpiryDate" class="form-label">Expiry Date</label>
						<input asp-for="ExpiryDate" class="form-control" placeholder="MM/YY" />
						<div class="invalid-feedback">
							Expiry date is required.
						</div>

					</div>
					<div class="col-md-6">
						<label asp-for="CardCvv" class="form-label">CVV</label>
						<input asp-for="CardCvv" class="form-control" placeholder="" />
						<div class="invalid-feedback">
							CVV is required.
						</div>
					</div>
				</div>
			</div> *@
			<div id="stripeCardBox" style="display:none; padding-top:20px; margin-top:20px;">
				<div class="row g-3">
					<div class="col-md-6">
						<label class="form-label">Card number<span style="color:red">*</span></label>
						<div id="card-number" class="form-control" style="padding:12px;"></div>
					</div>

					<div class="col-md-3">
						<label class="form-label">Expiration date<span style="color:red">*</span></label>
						<div id="card-expiry" class="form-control" style="padding:12px;"></div>
					</div>

					<div class="col-md-3">
						<label class="form-label">Security code<span style="color:red">*</span></label>
						<div id="card-cvc" class="form-control" style="padding:12px;"></div>
					</div>
				</div>
				<div id="stripe-error" style="margin-top:10px;color:#b00020;"></div>
			</div>
			@* end for Stripe *@

			@* Place Order btn *@
			<div class="confirm-button-container">
				<button asp-action="PlaceOrder" class="btn btn-primary confirm-button" id="submitButton" type="submit">
					Confirm order
				</button>
			</div>

		</form>
	</div>

	<div class="col-right">
		<div class="order-summary">
			<h2 class="mb-4">Order Summary</h2>
			<div class="product-list-container">
				@if (Model.CartItems != null && Model.CartItems.Any())
				{
					foreach (var item in Model.CartItems)
					{
						<div class="product-item">
							<div class="product-img-wrapper">
								<img src="@item.Note" alt="@item.ProductName" />
								<div class="qty-badge">@item.Quantity</div>
							</div>
							<div class="product-details">
								<div class="name">@item.ProductName</div>
								<div class="price">@currency @item.Price.ToString("N2")</div>
							</div>
						</div>
					}
				}
			</div>

			<div class="summary-totals">
				<div class="summary-row">
					<span>Subtotal</span>
					<h3>@currency @subtotal.ToString("N2")</h3>
				</div>
				<div class="summary-row">
					<span>Shipping</span>
					<h3>@currency @shippingCost.ToString("N2")</h3>
				</div>
				<div class="summary-row total-row">
					<span>Total (@currency)</span>
					<h1>@currency @total.ToString("N2")</h1>
				</div>
			</div>
		</div>
	</div>
</div>

