@model PetJoy.Models.CheckOut
@using System.Linq

@{
	ViewData["Title"] = "Order Summary";

	decimal subtotal = Model.CartItems?.Sum(item => item.Price * item.Quantity) ?? 0;
	decimal shippingCost = Model.ShippingCost;
	decimal total = subtotal + shippingCost;
	string currency = "JD";
}


