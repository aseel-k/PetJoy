@model PetJoy.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">



<style>
    body {
        background: #f1f5f9;
        font-family: 'Segoe UI', sans-serif;
    }

    .section-title {
        font-size: 1.4rem;
        font-weight: 800;
        margin: 40px 0 25px;
        padding-left: 12px;
        border-left: 6px solid #1e40af;
        color: #1e293b;
    }

        .section-title i {
            font-size: 1.5rem;
            margin-right: 8px;
            color: #1e3a8a; 
            background: rgba(30, 58, 138, 0.12);
            padding: 6px;
            border-radius: 8px;
        }


    .card {
        border-radius: 16px;
        box-shadow: 0 6px 16px rgba(0,0,0,.08);
        transition: .3s;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .stat-icon {
        width: 65px;
        height: 65px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        color: #fff;
        margin: auto;
    }

    .bg-blue {
        background: linear-gradient(135deg,#1e40af,#3b82f6);
    }

    .bg-green {
        background: linear-gradient(135deg,#16a34a,#22c55e);
    }

    .bg-orange {
        background: linear-gradient(135deg,#d97706,#f59e0b);
    }

    .bg-purple {
        background: linear-gradient(135deg,#7c3aed,#a78bfa);
    }

    .bg-pink {
        background: linear-gradient(135deg,#db2777,#f472b6);
    }

    .stat-number {
        font-size: 2rem;
        font-weight: 900;
    }

    .stat-label {
        font-size: .9rem;
        color: #475569;
    }

    table thead {
        background: #1e40af;
        color: #fff;
    }

    .equal-height-row {
        display: flex;
        flex-wrap: wrap;
    }

    .equal-height-card {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

        .equal-height-card canvas {
            flex-grow: 1;
        }

    .adoption-donut-wrapper {
        max-width: 260px;
        margin: 0 auto;
    }

    .equal-height-container {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .equal-height-body {
        flex: 1;
        overflow-y: auto;
    }

        .equal-height-body canvas {
            width: 100% !important;
            height: 100% !important;
        }

    .chart-fixed-height {
        height: 300px;
        position: relative;
    }

    table.card:hover {
        transform: none;
    }

</style>

<div class="container-fluid py-4">


    <!-- Adoption Section -->
    <div class="section-title" style="margin-top:5px;">
        <i class="bi bi-house-heart"></i>
        Adoption Overview
    </div>



    <div class="row g-4">
        <div class="col-md-4">
            <div class="card p-3 text-center">
                <div class="stat-icon bg-blue"><i class="bi bi-clipboard-data"></i></div>
                <div class="stat-label">Total Requests</div>
                <div class="stat-number">@Model.TotalRequests</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 text-center">
                <div class="stat-icon bg-purple">
                    <i class="fa-solid fa-paw"></i>
                </div>
                <div class="stat-label">Total Pets</div>
                <div class="stat-number">@Model.TotalPets</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 text-center">
                <div class="stat-icon bg-orange"><i class="bi bi-plus-circle"></i></div>
                <div class="stat-label">Pets Added Today</div>
                <div class="stat-number">@Model.PetsAddedToday</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-3">
        <div class="col-lg-6">
            <div class="card p-3">
                <h6 class="fw-bold">Adoption Status Overview</h6>
                <div class="adoption-donut-wrapper">
                    <canvas id="adoptionStatusChart" height="240"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card p-3">
                <h6 class="fw-bold">Adoption by City (Jordan)</h6>
                <canvas id="cityChart" height="240"></canvas>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card p-3">
                <h6 class="fw-bold">Latest Adoption Requests</h6>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Pet</th>
                            <th>Adopter</th>
                            <th>Status</th>
                            <th>ID</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.LatestRequests)
                        {
                            <tr>
                                <td>@item.AdoptPet?.PetName</td>
                                <td>@item.FullName</td>
                                <td>@item.Status</td>
                                <td>#@item.AdoptionFormId</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Today Checking Section -->
    <div class="section-title">
        <i class="bi bi-calendar-check"></i>
        Today Checking
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card p-3 text-center">
                <div class="stat-icon bg-green"><i class="bi bi-cart-check"></i></div>
                <div class="stat-label">Orders Today</div>
                <div class="stat-number">@Model.OrdersToday</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card p-3 text-center">
                <div class="stat-icon bg-pink"><i class="bi bi-cash-coin"></i></div>
                <div class="stat-label">Revenue Today</div>
                <div class="stat-number">@Model.RevenueToday JD</div>
            </div>
        </div>
    </div>

    <!-- Orders & Shop Section -->
    <div class="section-title">
        <i class="bi bi-cart-check"></i>
        Orders & Shop
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card p-3 text-center">
                <div class="stat-icon bg-blue"><i class="bi bi-bag"></i></div>
                <div class="stat-label">Total Orders</div>
                <div class="stat-number">@Model.TotalOrders</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 text-center">
                <div class="stat-icon bg-orange"><i class="bi bi-hourglass"></i></div>
                <div class="stat-label">Pending Orders</div>
                <div class="stat-number">@Model.PendingOrders</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 text-center">
                <div class="stat-icon bg-green"><i class="bi bi-check-circle"></i></div>
                <div class="stat-label">Completed Orders</div>
                <div class="stat-number">@Model.CompletedOrders</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 text-center">
                <div class="stat-icon bg-pink"><i class="bi bi-cash-stack"></i></div>
                <div class="stat-label">Total Revenue</div>
                <div class="stat-number">@Model.TotalRevenue JD</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-4">
        <!-- Pie Chart: Products by Shop Type -->
        <div class="col-lg-6">
            <div class="card p-3 h-100">
                <h6 class="fw-bold">Products by Shop Type</h6>
                <div class="chart-fixed-height">
                    <canvas id="shopTypeChart"></canvas>
                </div>
            </div>
        </div>

        <!-- BAR Chart: Products by Pet Type -->
        <div class="col-lg-6">
            <div class="card p-3 h-100">
                <h6 class="fw-bold">Most Demanded Products by Pet Type</h6>
                <div class="chart-fixed-height">
                    <canvas id="petTypeChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Latest Orders Full Width -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card p-3">
                <h6 class="fw-bold">Latest Orders</h6>
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Status</th>
                            <th>Total</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.LatestOrders)
                        {
                            <tr>
                                <td>#@order.ShopOrderMasterId</td>
                                <td>@order.Status</td>
                                <td>@order.TotalPrice JD</td>
                                <td>@order.OrderDate.ToShortDateString()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Revenue Section -->
    <div class="section-title">
        <i class="bi bi-graph-up-arrow"></i>
        Revenue Analytics
    </div>


    <div class="row mt-4">
        <div class="col-12">
            <div class="card chart-card">
                <div class="card-header">Revenue by Month (Last 12 Months)</div>
                <div class="card-body">
                    <canvas id="revenueChart" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    // Base dashboard colors for other charts
    const dashboardColors = [
        '#1e40af', // Blue
        '#22c55e', // Green
        '#f59e0b', // Amber
        '#ef4444', // Red
        '#a78bfa', // Purple
        '#38bdf8', // Light Blue
        '#db2777', // Pink
        '#f97316'  // Orange
    ];

    const cityLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CityLabels));
    const cityCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CityCounts));
    const shopTypeLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ShopTypeLabels));
    const shopTypeCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ShopTypeCounts));
    const monthLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthLabels));
    const monthRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthRevenue));
    const petTypeLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PetTypeLabels));
    const petTypeCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PetTypeCounts));

    // Adoption by City Chart
    new Chart(document.getElementById('cityChart'), {
        type: 'bar',
        data: {
            labels: cityLabels,
            datasets: [{
                data: cityCounts,
                backgroundColor: ['#1e40af','#6fcf97','#fbd38d','#dc2626','#56ccf2','#d6bcfa'],
                borderRadius: 8
            }]
        },
        options: {
            responsive: true,
            animation: { duration: 1200 },
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true } }
        }
    });

    // Products by Shop Type Pie Chart - vibrant colors with small gaps
     const vibrantColors = [
      '#4F46E5', // Bold Indigo
      '#2563EB', // Strong Blue
      '#06B6D4', // Cyan
      '#10B981', // Vivid Green
      '#22C55E', // Neon Green
      '#FACC15', // Bright Yellow
      '#F59E0B', // Bold Amber
      '#F97316', // Strong Orange
      '#EF4444', // Bold Red
      '#EC4899', // Hot Pink
      '#D946EF', // Bold Purple
      '#8B5CF6', // Electric Violet
      '#0EA5E9', // Bright Sky Blue
    ];



    const pieColors = vibrantColors.slice(0, shopTypeLabels.length);

    new Chart(document.getElementById('shopTypeChart'), {
        type: 'pie',
        data: {
            labels: shopTypeLabels,
            datasets: [{
                data: shopTypeCounts,
                backgroundColor: pieColors,
                borderColor: '#f1f5f9', // Gap color (matches page background)
                borderWidth: 2 // Small gap between slices
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: { padding: 14, boxWidth: 14 }
                }
            },
            animation: { animateRotate: true, duration: 1200 }
        }
    });

    // Revenue by Month Chart
    new Chart(document.getElementById('revenueChart'), {
        type: 'line',
        data: {
            labels: monthLabels,
            datasets: [{
                label: 'Revenue (JD)',
                data: monthRevenue,
                borderColor: dashboardColors[0],
                backgroundColor: 'rgba(30,64,175,0.3)',
                fill: true,
                tension: 0.4,
                pointRadius: 5,
                pointBackgroundColor: dashboardColors[0]
            }]
        },
        options: {
            responsive: true,
            animation: { duration: 1200 },
            plugins: { legend: { display: true } },
            scales: { y: { beginAtZero: true } }
        }
    });

    // Adoption Status Donut Chart
    const adoptionStatusData = {
        labels: ['Pending', 'Accepted', 'Rejected', 'Adopted'],
        datasets: [{
            data: [@Model.PendingRequests,@Model.AcceptedRequests,@Model.RejectedRequests,@Model.AdoptedPets],
            backgroundColor: [dashboardColors[2], dashboardColors[1], dashboardColors[3], '#3b82f6'],
            borderWidth: 0
        }]
    };

    new Chart(document.getElementById('adoptionStatusChart'), {
        type: 'doughnut',
        data: adoptionStatusData,
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '70%',
            animation: { animateRotate: true, duration: 1400 },
            plugins: { legend: { position: 'bottom', labels: { font: { size: 12 }, padding: 14 } } }
        }
    });

    // Products by Pet Type Bar Chart
        const barColors = dashboardColors.slice(0, petTypeLabels.length);

    new Chart(document.getElementById('petTypeChart'), {
        type: 'bar',
        data: {
            labels: petTypeLabels,
            datasets: [{
                data: petTypeCounts,
                backgroundColor: barColors,
                borderRadius: 8,
                barThickness: 22
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            indexAxis: 'y',
            plugins: { legend: { display: false } },
            scales: { x: { beginAtZero: true } }
        }
    });
</script>