@* Best selling products *@
<section id="foodies" class="my-3 pt-3">
	<div class="container py-5">
		<div class="section-header d-md-flex justify-content-between align-items-center mb-5 main-title">
			<h2 class="display-5 fw-normal ">Best Selling</h2>

			<div id="best-seller-filters" class="mb-4 mb-md-0">
				<p class="m-0 filter-group">
					<button class="filter-button active" data-filter="*">ALL</button>
					<button class="filter-button" data-filter=".Cat">Cat</button>
					<button class="filter-button" data-filter=".Dog">Dog</button>
					<button class="filter-button" data-filter=".Fish">Fish</button>
					<button class="filter-button" data-filter=".Bird">Bird</button>
					<button class="filter-button" data-filter=".SmallPets">Small Pets</button>
				</p>
			</div>
		</div>

		<div class="position-relative">
			<div class="swiper productsSwiper px-2">
				<div class="swiper-wrapper">
					@if (bestSellers != null && bestSellers.Any())
					{
						@foreach (var item in bestSellers)
						{
							string petClass = item.PetTypeId switch
							{
								1 => "Cat",
								2 => "Dog",
								3 => "Fish",
								4 => "Bird",
								5 => "SmallPets",
								_ => "other"
							};
							<div class="swiper-slide item @petClass">
								<div class="card h-100 position-relative border-0 shadow-sm" style="border-radius:20px; overflow:hidden;">
									<div class="product-image-wrapper p-3 d-flex align-items-center justify-content-center" style="height:200px;">
										<img src="@Url.Content(item.Note)" class="img-fluid" style="max-height:160px; object-fit:contain;" />
									</div>
									<div class="card-body p-3 d-flex flex-column justify-content-between mt-auto">
										<h3 title="@item.Name" class="card-title fs-6 m-0 text-capitalize fw-bold">@(item.Name.Length > 15 ? item.Name.Substring(0, 15) + ".." : item.Name)</h3>
										<h4 class="secondary-font mt-2" style="font-weight:700; color: #1e3a8a;">@item.Price JD</h4>
										<div class="d-flex flex-wrap mt-3">
											<button class="btn text-white add-to-cart-btn"
													style="background-color: #15406b;"
													data-product-id="@item.ShopProductId">
												Add to cart
											</button>
										</div>
									</div>
								</div>
							</div>
						}
					}
				</div>
			</div>

			<div class="swiper-button-next custom-nav-btn"></div>
			<div class="swiper-button-prev custom-nav-btn"></div>
		</div>
	</div>
</section>



