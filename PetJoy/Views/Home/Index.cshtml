<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://unpkg.com/isotope-layout@3/dist/isotope.pkgd.min.js"></script>


<script>
	$(document).ready(function () {

		// 1. MAIN HERO SWIPER
		const mainSwiper = new Swiper(".main-swiper", {
			loop: true,
			pagination: { el: ".swiper-pagination", clickable: true },
			autoplay: { delay: 5000, disableOnInteraction: false },
			on: {
				init: function() { runAnimation(this); },
				slideChangeTransitionStart: function () { runAnimation(this); }
			}
		});

		function runAnimation(s) {
			const activeSlide = s.slides[s.activeIndex];
			if (!activeSlide) return;
			const elements = activeSlide.querySelectorAll('.hero-content, .hero-image-container');
			elements.forEach(el => {
				el.style.animation = 'none';
				el.offsetHeight;
				el.style.animation = (el.classList.contains('hero-content')) ?
									 'fadeInUp 1s ease-out forwards' :
									 'fadeInUp 1.2s ease-out forwards';
			});
		}

		// 2. SPECIAL OFFERS SWIPER
		const offersSwiper = new Swiper(".offersSwiper", {
			slidesPerView: 1.2,
			spaceBetween: 30,
			loop: true,
			autoplay: { delay: 3000 },
			breakpoints: {
				640: { slidesPerView: 2, spaceBetween: 25 },
				1200: { slidesPerView: 2.8, spaceBetween: 30 }
			}
		});

		// 3. NEW ARRIVALS SWIPER
		const newArrivalsSwiper = new Swiper("#new-products .productsSwiper", {
			slidesPerView: 4,
			spaceBetween: 20,
			observer: true,
			observeParents: true,
			navigation: {
				nextEl: "#new-products .swiper-button-next",
				prevEl: "#new-products .swiper-button-prev",
			},
			breakpoints: {
				320: { slidesPerView: 1.2 },
				768: { slidesPerView: 2.5 },
				1024: { slidesPerView: 4 }
			}
		});

		// 4. BEST SELLING SWIPER
		const bestSellersSwiper = new Swiper("#foodies .productsSwiper", {
			slidesPerView: 4,
			spaceBetween: 20,
			observer: true,
			observeParents: true,
			navigation: {
				nextEl: "#foodies .swiper-button-next",
				prevEl: "#foodies .swiper-button-prev",
			},
			breakpoints: {
				0: { slidesPerView: 1 },
				576: { slidesPerView: 2 },
				992: { slidesPerView: 4 }
			}
		});

		// 5. NEW ARRIVALS FILTERING (Targeting buttons inside #new-products)
		$('#new-products .filter-button').on('click', function () {
			const filterValue = $(this).attr('data-filter');

			$('#new-products .filter-button').removeClass('active');
			$(this).addClass('active');

			if (filterValue === '*') {
				$('#new-products .swiper-slide').show();
			} else {
				$('#new-products .swiper-slide').hide();
				$('#new-products ' + filterValue).show();
			}

			newArrivalsSwiper.update();
			newArrivalsSwiper.slideTo(0, 0); // Reset arrows to beginning
		});

		// 6. BEST SELLING FILTERING (Targeting buttons inside #foodies)
		$('#foodies .filter-button').on('click', function () {
			const filterValue = $(this).attr('data-filter');

			$('#foodies .filter-button').removeClass('active');
			$(this).addClass('active');

			if (filterValue === '*') {
				$('#foodies .swiper-slide').show();
			} else {
				$('#foodies .swiper-slide').hide();
				$('#foodies ' + filterValue).show();
			}

			bestSellersSwiper.update();
			bestSellersSwiper.slideTo(0, 0); // Reset arrows to beginning
		});

		// 7. ADD TO CART AJAX
		$(document).on('click', '.add-to-cart-btn', function (e) {
			e.preventDefault();
			var button = $(this);
			var productId = button.data('product-id');

			button.prop('disabled', true).text('Adding...');

			$.ajax({
				url: '@Url.Action("AddToCart", "Home")',
				type: 'POST',
				data: { id: productId, quantity: 1 },
				success: function (response) {
					if (response.success) {
						showSuccessAlert('Added to your cart!');
					} else {
						showSuccessAlert(response.message || 'Error adding item to cart.', 'danger');
					}
				},
				error: function () {
					showSuccessAlert('An unexpected error occurred.', 'danger');
				},
				complete: function () {
					button.prop('disabled', false).text('Add to cart');
				}
			});
		});

		function showSuccessAlert(message, type = 'success') {
			var alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
			var alertHtml = `
				<div class="alert ${alertClass} alert-dismissible fade show" role="alert">
					 ${message}
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
				</div>
			`;
			$('#alertPlaceholder').append(alertHtml);
			var newAlert = $('#alertPlaceholder').children().last();

			var AddedItem = $("#cartCount").text();
			var NewAddedItem = parseInt(AddedItem) + 1;
			$("#cartCount").text(NewAddedItem);

			setTimeout(function () {
				newAlert.alert('close');
			}, 2000);
		}
	});

	function sideScroll(direction) {
		const box = document.getElementById('scrollBox');
		if(box) {
			const scrollAmount = 400;
			box.scrollLeft += (direction * scrollAmount);
		}
	}
</script>