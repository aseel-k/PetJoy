		height: 100vh;
	}

	.swiper-slide {
	 align-items: center;
	}

	.hero-content {
		padding-left: 80px;
		text-align: left;
	}

	.hero-title-small {
		font-style: italic;
		font-size: 2rem;
		color: #1e3a8a;
	}

	.hero-title-main {
		font-size: 5rem;
		font-weight: 800;
		line-height: 1;
		margin: 10px 0;
		text-transform: uppercase;
		color: #1e3a8a;
