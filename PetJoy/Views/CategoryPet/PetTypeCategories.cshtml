@model IEnumerable<PetJoy.Models.ShopType>
@using System.Text.RegularExpressions
@using System.Text.Json
@using System.Globalization

@{

    var originalPetName = (string)ViewBag.PetName;

    var formattedPetName = CultureInfo.CurrentCulture.TextInfo.ToTitleCase(originalPetName.ToLower());

    ViewData["Title"] = formattedPetName;


    var allPaths = new List<string>();
    var basePath = "~/images/shopProduct/";


    var sanitizedPetName = System.Text.RegularExpressions.Regex.Replace(originalPetName, @"[^a-zA-Z0-9]", "");
    var lowerPetName = sanitizedPetName.ToLower();
    var defaultUrl = Url.Content($"{basePath}default.png");
}

<div class="container" style="padding-top: 10px;">

    <p class="mb-0 text-muted small" style="margin-left: -5px;">
        <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none">Home</a> &gt;
        <span>@formattedPetName</span>
    </p>


    <h1 class="fw-bold" style="font-size: 1.5rem; color: #333; padding-left:1px;">@formattedPetName</h1>
</div>



<div class="container py-4">
    <div class="row">

        @if (Model != null)
        {
            @foreach (var type in Model)
            {

                allPaths.Clear();
                var typeName = type.Name;

                string baseImageName;
                switch (typeName)
                {
                    case "Beds": baseImageName = "bed"; break;
                    case "Bowls & Containers": baseImageName = "bowls&containers"; break;
                    case "Health & Wellness": baseImageName = "health&wellness"; break;
                    case "Food & Treats": baseImageName = "food"; break;
                    case "Aquariums": baseImageName = "aquariums"; break;
                    case "Travel Crates": baseImageName = "travelcrates"; break;
                    case "Cages": baseImageName = "cages"; break;
                    case "Toys": baseImageName = "toys"; break;
                    case "Litter": baseImageName = "litter"; break;
                    case "Grooming": baseImageName = "grooming"; break;
                    case "Collar": baseImageName = "collar"; break;
                    case "Clothes": baseImageName = "clothes"; break;
                    case "Accessories": baseImageName = "accessories"; break;
                    default:
                        baseImageName = System.Text.RegularExpressions.Regex.Replace(typeName, @"[^a-zA-Z0-9]", "").ToLower();
                        break;
                }

                allPaths.Add(Url.Content($"{basePath}{baseImageName}{lowerPetName}.png"));
                allPaths.Add(Url.Content($"{basePath}{baseImageName}{lowerPetName}.jpg"));
                allPaths.Add(Url.Content($"{basePath}{lowerPetName}{baseImageName}.png"));
                allPaths.Add(Url.Content($"{basePath}{lowerPetName}{baseImageName}.jpg"));
                allPaths.Add(Url.Content($"{basePath}{baseImageName}.png"));
                allPaths.Add(Url.Content($"{basePath}{baseImageName}.jpg"));
                allPaths.Add(Url.Content($"{basePath}{lowerPetName}{baseImageName}.png"));

                var jsonPaths = System.Text.Json.JsonSerializer.Serialize(allPaths);
                var initialPath = allPaths.First();

                <div class="col-6 col-md-3 mb-4 d-flex justify-content-center">
                    <a asp-controller="ShopProduct"
                       asp-action="ShopProduct"
                       asp-route-petTypeId="@ViewBag.PetId"
                       asp-route-typeId="@type.ShopTypeId"
                       class="text-decoration-none text-dark text-center">

                        <div class="rounded-circle mb-2"
                             style="width:140px; height:140px; background:#f3f3f3; overflow:hidden; display:flex; align-items:center; justify-content:center;">

                            <img src="@initialPath"
                                 data-paths='@jsonPaths'
                                 data-default="@defaultUrl"
                                 style="width:163%; height:110%; object-fit:cover;"
                                 alt="@type.Name" />

                        </div>

                        <h6 class="fw-bold">@type.Name</h6>

                    </a>
                </div>
            }
        }
        else
        {
            <p class="text-center w-100">No shop categories found for @formattedPetName.</p>
        }

    </div>
</div>