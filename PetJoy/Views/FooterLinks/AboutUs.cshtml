@{
    ViewData["Title"] = "About Us";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background: linear-gradient(180deg, #eef6ff, #ffffff);
        font-family: 'Segoe UI', sans-serif;
    }



    /* HEADER */
    .about-header {
        text-align: center;
        padding: 80px 20px 50px;
    }

        .about-header h1 {
            font-size: 2.7rem;
            font-weight: 700;
            color: #2563eb;
        }

        .about-header p {
            max-width: 700px;
            margin: 20px auto 0;
            color: #5b7bb4;
            font-size: 1.25rem;
            line-height: 1.8;
        }

    /* PET CARD */
    .pet-card {
        background: #ffffff;
        border-radius: 28px;
        padding: 20px;
        box-shadow: 0 18px 40px rgba(37, 99, 235, 0.15);
        transition: all 0.35s ease;
        height: 100%;
    }

        .pet-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 25px 55px rgba(37, 99, 235, 0.25);
        }


    .pet-image {
        width: 100%;
        height: 260px;
        object-fit: cover;
        object-position: center top; /* keeps top visible */
        border-radius: 22px;
    }


    .pet-name {
        font-weight: 600;
        font-size: 1.2rem; /* slightly larger */
        color: #2563eb;
        margin-top: 16px;
    }

    .pet-text {
        font-size: 1rem; /* larger paragraph text */
        color: #6b7fa8;
        margin-top: 8px;
        line-height: 1.6;
    }

    /* RESPONSIVE */
    @@media (max-width: 1200px) {
        .pet-image {
            height: 240px;
        }
    }

    @@media (max-width: 992px) {
        .pet-image {
            height: 220px;
        }

        .about-header h1 {
            font-size: 2.3rem;
        }

        .about-header p {
            font-size: 1.15rem;
        }
    }

    @@media (max-width: 768px) {
        .pet-card {
            padding: 18px;
        }

        .pet-image {
            height: 200px;
        }

        .pet-name {
            font-size: 1.1rem;
        }

        .pet-text {
            font-size: 0.95rem;
        }
    }

    @@media (max-width: 576px) {
        .about-header h1 {
            font-size: 2rem;
        }

        .about-header p {
            font-size: 1rem;
        }

        .pet-image {
            height: 180px;
        }

        .pet-name {
            font-size: 1rem;
        }

        .pet-text {
            font-size: 0.9rem;
        }
    }

</style>

<!-- HEADER -->
<div class="about-header">
    <h1>Where PetJoy Began</h1>
    <p>
        PetJoy was born from the everyday moments we share with our pets.
        Through care, responsibility, and companionship, they inspire every
        design choice and feature we create.
    </p>
</div>

<!-- PETS GRID -->
<div class="container pb-5">
    <div class="row g-4 justify-content-center">

        <!-- PET 1 -->
        <div class="col-lg-3 col-md-6 col-sm-12">
            <div class="pet-card text-center">
                <img src="~/images/Toffii.jpg" class="pet-image" alt="Pet">
                <div class="pet-name">Toffii</div>
                <div class="pet-text">
                    Hi, I’m Toffii! I’m cute, cuddly, and my mom Haneen says I’m her little daughter - always ready for a nap!
                </div>
            </div>
        </div>

        <!-- PET 2 -->
        <div class="col-lg-3 col-md-6 col-sm-12">
            <div class="pet-card text-center">
                <img src="~/images/Louz.jpg" class="pet-image " alt="Pet">
                <div class="pet-name">Louz</div>
                <div class="pet-text">
                    I’m Louz! I’m curious, a little crazy, and my mom Aseel says I’m always getting into trouble!
                </div>
            </div>
        </div>

        <!-- PET 3 -->
        <div class="col-lg-3 col-md-6 col-sm-12">
            <div class="pet-card text-center">
                <img src="~/images/Vicky2.jpg" class="pet-image" alt="Pet">
                <div class="pet-name">Vicky</div>
                <div class="pet-text">
                    Hi, I’m Vicky! I’m playful and full of energy - my mom Hala says I never stop moving!
                </div>
            </div>
        </div>

        <!-- PET 4 -->
        <div class="col-lg-3 col-md-6 col-sm-12">
            <div class="pet-card text-center">
                <img src="~/images/Bunduq2.jpg" class="pet-image" alt="Pet">
                <div class="pet-name">Bunduq</div>
                <div class="pet-text">
                    I’m Bunduq! I’m friendly and bouncy - my mom Razan says I make every day more fun!
                </div>
            </div>
        </div>

    </div>
</div>