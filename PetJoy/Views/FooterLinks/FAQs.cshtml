@{
    ViewData["Title"] = "Frequently Asked Questions";
    Layout = "_Layout";
}

<style>
    body {
        font-family: Arial, sans-serif;
        color: #102C4C;
    }

    .py-0 {
        background-color: #F2F7FF !important;
        padding-top: 8px !important;
        padding-bottom: 8px !important;
    }

    .container-fluid {
        padding: 0;
    }

    .py-5 {
        padding-top: 3rem !important;
        padding-bottom: 3rem !important;
    }

    .faq-title {
        color: #102C4C;
        font-family: 'Poppins', sans-serif;
        font-weight: 900;
        font-size: 2rem;
        margin-bottom: 1rem;
        margin-left: -50px;
    }

    .accordion-item {
        border-bottom: 1px solid #e0e0e0;
        margin-bottom: 0.5rem;
        background-color: #fff;
        border-radius: 6px;
        overflow: hidden;
        border: none;
    }

        .accordion-item.active .accordion-header {
            background-color: #E6F0FF;
        }

    .accordion-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.25rem;
        cursor: pointer;
        font-size: 1.1rem;
        font-weight: 500;
    }

        .accordion-header:hover {
            background-color: #e6f0ff;
        }

    .accordion-arrow {
        transition: transform 0.3s ease;
    }

    .accordion-body {
        display: none;
        padding: 1rem 1.25rem;
        font-size: 1rem;
        line-height: 1.6;
        color: #102C4C;
    }

    .accordion-item.active .accordion-body {
        display: block;
    }

    .accordion-item.active .accordion-arrow {
        transform: rotate(180deg);
    }

    .section-divider {
        border: none;
        height: 2px;
        width: 100%;
        background-color: #102C4C;
        margin: 40px 0;
        border-radius: 0px;
    }

    
    @@media (max-width: 991px) {
        .faq-title {
            margin-left: 0 !important; 
            text-align: center;
            font-size: 1.6rem;
        }

        .hero-title-text {
            margin-left: 0 !important;
            white-space: normal !important; 
            text-align: center;
            font-size: 1.6rem !important;
        }

        .hero-description-text {
            text-align: center !important;
            padding: 0 15px;
        }

        .hero-image {
            max-height: 200px !important;
            margin-top: 15px !important;
        }
    }
</style>

<section class="py-0">
    <div class="container-fluid">
        <div class="row align-items-center" style="margin: 0;">

            <div class="col-lg-5 offset-lg-1 mb-0 mb-lg-0" style="padding-top: 15px; padding-bottom: 15px;">

                <h2 class="hero-title-text mb-0"
                    style="font-family: 'Poppins', sans-serif; font-weight: 900; color: #102C4C; text-transform: uppercase; font-size: 2rem; white-space: nowrap; margin-left: -50px; margin-top: 0; margin-bottom: 0;">
                    FREQUENTLY ASKED QUESTIONS
                </h2>

                <p class="hero-description-text" style="font-family: Arial, sans-serif; font-size: 1rem; color: #102C4C; margin-top: 0.5rem; font-weight: 400; margin-bottom: 0; text-align: justify;">
                    At PETJOY, we recognize that every pet holds a universe of emotions and unspoken needs,
                    each woven into the bond they share with you. These FAQs serve as a gentle guide through
                    our world of services, offering clarity and comfort as you explore what we provide.
                    We hope your experience with us feels effortless, reassuring, and grounded in the knowledge
                    that your companion’s well-being is always our highest priority.
                </p>

            </div>

            <div class="col-lg-6 text-center" style="padding: 0;">
                <img src="~/images/CQA.png"
                     alt="A beautiful Bengal cat relaxing"
                     class="img-fluid hero-image"
                     style="max-height: 250px; width: 100%; object-fit: cover; display: block; margin: 0 auto; padding: 0;">
            </div>

        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 offset-lg-1">

                <h3 class="faq-title">General Inquiries</h3>

                <div class="accordion-group" id="generalInquiriesAccordion">

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span>What makes PETJOY different from ordinary pet stores?</span>
                            <span class="accordion-arrow">&#9660;</span>
                        </div>
                        <div class="accordion-body">
                            PETJOY transcends the concept of a traditional pet shop. We are a devotion-driven haven, bringing together premium essentials, adoption opportunities, and compassionate care services—all woven into a single, thoughtfully curated experience designed to enrich the bond you share with your pet.
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span>Can I find everything my pet needs in one place?</span>
                            <span class="accordion-arrow">&#9660;</span>
                        </div>
                        <div class="accordion-body">
                            Absolutely. Our collection is intentionally comprehensive—ranging from high-quality food and wellness items to products, toys, accessories, and specialized care resources. PETJOY exists to ensure you never need to search elsewhere for what your companion deserves.
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span>Do PETJOY only operate in Jordan?</span>
                            <span class="accordion-arrow">&#9660;</span>
                        </div>
                        <div class="accordion-body">
                            We're headquartered in Amman, Jordan, where our dedicated team works tirelessly to deliver exceptional service.
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span>How fast can I expect to receive my order?</span>
                            <span class="accordion-arrow">&#9660;</span>
                        </div>
                        <div class="accordion-body">
                            Our team prioritizes swift, reliable delivery. Once your order is placed, we move with intention and care to ensure your items arrive as quickly—and as impeccably—as possible.
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span>How does PETJOY ensure a compassionate experience for customers?</span>
                            <span class="accordion-arrow">&#9660;</span>
                        </div>
                        <div class="accordion-body">
                            We operate with empathy at our core. Our team listens attentively, responds thoughtfully, and provides support that feels personal because we believe every interaction should honor the bond you share with your pet.
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span>What if I have a question outside regular hours?</span>
                            <span class="accordion-arrow">&#9660;</span>
                        </div>
                        <div class="accordion-body">
                            You’re never alone. Our team remains available to assist you whenever you need guidance, ensuring that care and answers are always within reach.
                        </div>
                    </div>
                </div>

                <hr class="section-divider">

                <h3 class="faq-title" style="margin-top: 2.5rem;">Products & Nutrition</h3>

                <div class="accordion-group" id="productFaqAccordion">

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span>What should I do if I need help choosing the right products for my pet?</span>
                            <span class="accordion-arrow">&#9660;</span>
                        </div>
                        <div class="accordion-body">
                            Simply reach out. Our team is available day and night, ready to listen, recommend, and guide you toward the choices that best suit your animal’s unique needs, temperament, and lifestyle.
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span>How does PETJOY curate the products available in the shop?</span>
                            <span class="accordion-arrow">&#9660;</span>
                        </div>
                        <div class="accordion-body">
                            Every item is chosen with discerning intention. We select products that meet high standards of quality, wellness, and comfort, ensuring your pet receives only what is safe, nourishing, and worthy of their trust.
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span>Can PETJOY help me choose the best food for my pet?</span>
                            <span class="accordion-arrow">&#9660;</span>
                        </div>
                        <div class="accordion-body">
                            Yes. Our team offers tailored guidance rooted in knowledge and empathy. Whether your companion is playful, selective, sensitive, or senior, we help you find nutrition that supports their unique body and spirit.
                        </div>
                    </div>

                </div>

                <hr class="section-divider">

                <h3 class="faq-title" style="margin-top: 2.5rem;">Adoption & Care Services</h3>

                <div class="accordion-group" id="adoptionFaqAccordion">

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span>How does the adoption service work at PETJOY?</span>
                            <span class="accordion-arrow">&#9660;</span>
                        </div>
                        <div class="accordion-body">
                            Our adoption service connects animals seeking warmth and safety with families ready to love them. We carefully assess each case to ensure compatibility, well-being, and a seamless transition into a nurturing home where the animal can flourish physically and emotionally.
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span>What types of care services does PETJOY offer?</span>
                            <span class="accordion-arrow">&#9660;</span>
                        </div>
                        <div class="accordion-body">
                            PETJOY’s Care service guides pet owners on how to support their sick animals. We provide clear advice on health, nutrition, behavior, and overall well-being. You’ll also find recommendations for trusted veterinarians across Jordan.
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span>What should I expect when beginning the adoption journey through PETJOY?</span>
                            <span class="accordion-arrow">&#9660;</span>
                        </div>
                        <div class="accordion-body">
                            Expect sincerity, transparency, and deep regard for the animal’s well-being. We match families and pets with thoughtful care, ensuring the transition is seamless.
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span>Does PETJOY provide support after adoption?</span>
                            <span class="accordion-arrow">&#9660;</span>
                        </div>
                        <div class="accordion-body">
                            Absolutely. Our commitment doesn’t end once a pet finds a home. We continue offering advice, resources, and compassionate follow-up to help your new companion settle comfortably into their life with you.
                        </div>
                    </div>

                    <div class="accordion-item">
                        <div class="accordion-header">
                            <span>Are PETJOY’s services suitable for first-time pet parents?</span>
                            <span class="accordion-arrow">&#9660;</span>
                        </div>
                        <div class="accordion-body">
                            Yes, especially so. Whether you’re new to pet parenthood or seasoned in it, we provide the clarity, tools, and emotional reassurance you need to navigate every stage with confidence.
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</section>

<script>
    const headers = document.querySelectorAll('.accordion-header');

    headers.forEach(header => {
        header.addEventListener('click', () => {
            const item = header.parentElement;
            item.classList.toggle('active');
        });
    });
</script>