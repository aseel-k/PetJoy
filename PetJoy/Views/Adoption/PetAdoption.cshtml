@model AdoptionViewModel

@{
    ViewBag.Title = "Pet Adoption";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #f0f4f8 0%, #d7e1ec 100%);
        min-height: 100vh;
    }

    .main-container {
        min-height: 100vh;
        padding: 2rem 0;
    }

    .card-custom {
        border: none;
        border-radius: 20px;
        background-color: #ffffff;
        box-shadow: 0 15px 35px rgba(30,82,135,0.1);
    }

    .title-text {
        color: #1e5287;
        font-weight: 700;
        font-family: 'Fredoka',sans-serif;
        font-size: 2.2rem;
    }

    .form-control, .form-select {
        border-radius: 12px;
        border: 1px solid #e1e5ea;
        padding: 1rem 0.75rem;
        background-color: #fdfdfd;
        height: 58px;
        color: #1e5287;
        font-weight: 500;
        box-shadow: none;
    }

        .form-control:focus, .form-select:focus {
            border-color: #1e5287;
            box-shadow: 0 0 0 4px rgba(30,82,135,0.1);
            background-color: #fff;
        }

    input[type=number]::-webkit-inner-spin-button, input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        -moz-appearance: textfield;
    }

    .form-floating > label {
        padding-left: 1.2rem;
        color: #8898aa;
        font-size: 0.95rem;
        transition: all 0.2s ease-in-out;
        pointer-events: none;
    }

        .form-floating > label > i {
            color: #1e5287 !important;
            font-weight: bold;
            margin-right: 8px;
            font-size: 1.1rem;
            vertical-align: middle;
        }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label,
    .form-floating > .form-select ~ label {
        opacity: 1;
        color: #1e5287;
        transform: scale(0.85) translateY(-0.7rem) translateX(0.15rem);
        font-weight: 600;
        background-color: transparent;
    }

    .file-upload-wrapper {
        position: relative;
        height: 58px;
        border: 1px dashed #1e5287;
        border-radius: 12px;
        background-color: #f8fbff;
        display: flex;
        align-items: center;
        padding: 0 15px;
        transition: all 0.3s;
    }

        .file-upload-wrapper:hover {
            background-color: #eef6ff;
        }

        .file-upload-wrapper input[type=file] {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
        }

    .file-upload-text {
        color: #1e5287;
        font-size: 0.9rem;
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 500;
    }

    .btn-primary-custom {
        background-color: #1e5287;
        border: none;
        border-radius: 12px;
        padding: 15px;
        font-weight: 600;
        font-size: 1.1rem;
        box-shadow: 0 4px 15px rgba(30,82,135,0.2);
        color: #fff !important;
    }

        .btn-primary-custom:hover {
            background-color: #163b61;
            transform: translateY(-2px);
            color: #fff !important;
        }

        .btn-primary-custom:active, .btn-primary-custom:focus {
            background-color: #1e5287 !important;
        }

    .form-floating.textarea-container > .form-control {
        height: 150px;
    }

    .form-floating.textarea-container > label {
        transform: scale(0.85) translateY(-0.7rem) translateX(0.15rem);
        font-weight: 600;
        opacity: 1;
        color: #1e5287;
    }

    .invalid-feedback {
        display: none;
    }

    .was-validated .invalid-feedback, .was-validated .file-upload-wrapper:has(input:invalid) + .invalid-feedback {
        display: block !important;
    }

    /* Modal styling */
    #petDetailModal .modal-dialog {
        max-width: 400px;
    }

    #petDetailModal .modal-content {
        border-radius: 20px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        border: none;
    }

    #petDetailModal .modal-header {
        background-color: #1e5287;
        color: white;
        border-radius: 20px 20px 0 0;
        border-bottom: none;
        padding: 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    #modalHeaderTitle {
        font-family: 'Fredoka',sans-serif;
        font-weight: 600;
        font-size: 1.25rem;
    }

    #petDetailModal .modal-body {
        padding: 1.5rem;
        text-align: center;
    }

    .pet-image-container {
        width: 90%;
        height: 180px;
        overflow: hidden;
        border-radius: 15px;
        margin: 0 auto 1.5rem;
        box-shadow: 0 3px 10px rgba(0,0,0,0.1);
        background-color: #fff;
        border: 1px solid #e1e5ea;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .pet-image-container img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 10px;
        }

    #modalPetName {
        color: #1e5287;
        font-family: 'Fredoka',sans-serif;
        font-weight: 700;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .info-badge {
        font-size: 0.8rem;
        padding: 0.4em 0.8em;
        border-radius: 50px;
        font-weight: 500;
        background-color: #e6eef6;
        color: #1e5287;
    }
</style>

<div class="d-flex justify-content-center align-items-center main-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">

                <div class="card card-custom p-4 p-md-5">
                    <div class="text-center mb-3">
                        <h2 class="title-text mb-2">
                            <i class="bi bi-patch-plus-fill me-2"></i>Add Pet for Adoption
                        </h2>
                        <p class="text-muted">Enter the details of the pet available for adoption</p>
                    </div>


                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-3" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }



                    <form id="adoptionForm" asp-action="PetAdoption" asp-controller="Adoption" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                        <div class="row g-3">

                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="PetName" class="form-control" id="petName" placeholder="Pet Name" required />
                                    <label for="petName"><i class="bi bi-tag"></i>Pet Name <span style="color:red">*</span></label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Animal" class="form-select" id="animalType" required>
                                        <option value="" selected disabled>Select Type </option>
                                        <option value="Cat">Cat</option>
                                        <option value="Dog">Dog</option>
                                        <option value="Fish">Fish</option>
                                        <option value="Bird">Bird</option>
                                        <option value="Small Pets">Small Pets</option>
                                    </select>
                                    <label for="animalType"><i class="bi bi-heart"></i>Animal Type  <span style="color:red">*</span></label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Age" type="number" class="form-control" id="ageInput" placeholder="Age" min="0" required />
                                    <label for="ageInput"><i class="bi bi-calendar-check"></i>Age (Years)  <span style="color:red">*</span></label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Gender" class="form-select" id="genderSelect" required>
                                        <option value="" selected disabled>Select Gender</option>
                                        <option value="Female">Female</option>
                                        <option value="Male">Male</option>
                                    </select>
                                    <label for="genderSelect"><i class="bi bi-gender-ambiguous"></i>Gender  <span style="color:red">*</span></label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Breed" class="form-control" id="breedInput" placeholder="Breed" required />
                                    <label for="breedInput"><i class="bi bi-info-circle"></i>Breed  <span style="color:red">*</span></label>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="MedicalHistory" class="form-control" id="medicalHistory" placeholder="Medical History" required />
                                    <label for="medicalHistory"><i class="bi bi-hospital"></i>Medical History  <span style="color:red">*</span></label>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating textarea-container">
                                    <textarea asp-for="Description" class="form-control" id="descriptionInput" placeholder="Description" required></textarea>
                                    <label for="descriptionInput"><i class="bi bi-chat-square-text"></i>Description  <span style="color:red">*</span></label>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="file-upload-wrapper mt-2">
                                    <input asp-for="PetImage" type="file" accept="image/*" id="customFile" onchange="updateFileName(this)" required />
                                    <div class="file-upload-text">
                                        <span><i class="bi bi-image me-2"></i> <span id="fileNameText">Click to upload a pet image...  <span style="color:red">*</span></span></span>
                                        <i class="bi bi-cloud-upload"></i>
                                    </div>
                                </div>
                                <div class="invalid-feedback">Please upload a pet image</div>
                            </div>

                        </div>

                        <div class="text-center mt-5">
                            <button type="submit" class="btn btn-primary-custom w-100" id="uploadButton">
                                <i class="bi bi-send me-2"></i>Submit Pet for Adoption
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    function updateFileName(input) {
        var textElement = document.getElementById('fileNameText');
        if (input.files && input.files.length > 0) {
            textElement.innerText = input.files[0].name;
            textElement.style.color = "#1e5287";
        } else {
            textElement.innerText = "Click to upload a pet image...";
            textElement.style.color = "";
        }
    }
</script>

<script>
    (function () {
        'use strict';

        var forms = document.querySelectorAll('.needs-validation');

        Array.prototype.slice.call(forms)
            .forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
    })();

    function updateFileName(input) {
        var textElement = document.getElementById('fileNameText');
        if (input.files && input.files.length > 0) {
            textElement.innerText = input.files[0].name;
            textElement.style.color = "#1e5287";
        } else {
            textElement.innerText = "Click to upload a pet image...";
            textElement.style.color = "";
        }
    }
</script>


<script>
    // Auto-hide success alert after seconds
    setTimeout(function () {
        var alert = document.querySelector(".alert-success");
        if (alert) {
            var bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        }
    }, 3000);
</script>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}